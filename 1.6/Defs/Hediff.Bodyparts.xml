		<jobString>Installing stomach reactor.</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>NuclearStomach</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>NuclearStomach</li>
			</thingDefs>
		</fixedIngredientFilter>
		<appliedOnFixedBodyParts>
			<li>Stomach</li>
		</appliedOnFixedBodyParts>
		<addsHediff>NuclearStomach</addsHediff>
		<uiIconThing>NuclearStomach</uiIconThing>
	</RecipeDef>

</Defs>