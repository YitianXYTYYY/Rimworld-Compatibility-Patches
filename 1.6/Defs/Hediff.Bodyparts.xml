			<ComponentSpacer>4</ComponentSpacer>
		</costList>
		<recipeMaker>
			<researchPrerequisite>ArtificialMetabolism</researchPrerequisite>
		</recipeMaker>
	</ThingDef>
	<RecipeDef ParentName="MSE_SurgeryInstallModuleBase" MayRequire="mse2.core">
		<defName>InstallNuclearStomach</defName>
		<label>install stomach reactor</label>
		<description>Install a stomach reactor.</description>
		<descriptionHyperlinks>
			<ThingDef>NuclearStomach</ThingDef>
