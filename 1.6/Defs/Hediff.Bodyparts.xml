	<!-- Nuclear stomach -->
	<HediffDef ParentName="MSE_ModuleAddedBionic" MayRequire="mse2.core">
		<defName>NuclearStomach</defName>
		<label>stomach reactor</label>
		<labelNoun>a stomach reactor</labelNoun>
		<description>An installed stomach reactor. A micro-nuclear reactor combined with complex chemical synthesis replaces the body's need for food energy. Food is required only to replace matter lost from the body, reducing the user's intake needs significantly. This reactor prevents getting food poisoning. However, there is little room to shield the reactor, so the radiation increases the risk of cancer.</description>
		<descriptionHyperlinks>
			<ThingDef>NuclearStomach</ThingDef>
		</descriptionHyperlinks>
		<spawnThingOnRemoved>NuclearStomach</spawnThingOnRemoved>
		<hediffGivers>
			<li Class="HediffGiver_Random">
				<mtbDays>120</mtbDays>
				<hediff>Carcinoma</hediff>
				<partsToAffect>
					<li>Torso</li>
				</partsToAffect>
			</li>
		</hediffGivers>
		<stages>
			<li>
				<hungerRateFactor>0.2</hungerRateFactor>
				<foodPoisoningChanceFactor>0</foodPoisoningChanceFactor>
			</li>
		</stages>
	</HediffDef>
	<ThingDef ParentName="MSE_ModuleBionic" MayRequire="mse2.core">
		<defName>NuclearStomach</defName>
		<label>stomach reactor</label>
		<description>A micro-nuclear reactor combined with complex chemical synthesis replaces the body's need for food energy. Food is required only to replace matter lost from the body, reducing the user's intake needs significantly. This reactor prevents getting food poisoning. However, there is little room to shield the reactor, so the radiation increases the risk of cancer.</description>
		<descriptionHyperlinks>
			<RecipeDef>InstallNuclearStomach</RecipeDef>
		</descriptionHyperlinks>
		<thingSetMakerTags>
			<li>RewardStandardLowFreq</li>
		</thingSetMakerTags>
		<costList>
