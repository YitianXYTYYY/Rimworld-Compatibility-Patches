<Defs>

	<ThingDef ParentName="Apparel_ClothMask" MayRequire="wasterbreath.mod">
		<defName>Apparel_ToxClothMask</defName>
		<label>face mask - tox</label>
		<description>Several layers of fabric soaked in unstable chemfuel compounds. The treatment is meant to neutralize tox gas, but a charged filter leaches poison into the wearer's lungs.\n\nWhile the filter is charged, causes toxic buildup over time.\n\nThe wrap is soaked with toxic substances. I love the smell of napalm in the morning!</description>
		<descriptionHyperlinks>
			<HediffDef>ToxicBuildup</HediffDef>
		</descriptionHyperlinks>
		<comps>
			<li Class="Tox.CompProperties_ToxFilterCharge">
				<fuelDef>Chemfuel</fuelDef>
				<fuelAmount>10</fuelAmount>
				<chargeDays>5</chargeDays>
				<hediff>ToxApparelPoisoningMask</hediff>
				<wasterHediff>ToxApparelWasterStimulusMask</wasterHediff>
				<part>Head</part>
			</li>
		</comps>
		<costList>
			<Chemfuel>5</Chemfuel>
		</costList>
		<recipeMaker>
			<researchPrerequisite Inherit="False"/>
			<researchPrerequisites Inherit="False">
				<li>ComplexClothing</li>
				<li>ToxFilterApparel</li>
			</researchPrerequisites>
			<displayPriority>166</displayPriority>
		</recipeMaker>
		<tickerType>Normal</tickerType>
	</ThingDef>

