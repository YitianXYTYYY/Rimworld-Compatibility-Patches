<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[@Name="MechCentipede"]</xpath>
		<value>
			<statBases Operation="Safe">
				<ArmorRating_Blunt Operation="SafeReplace">0.5</ArmorRating_Blunt>
				<ArmorRating_Sharp Operation="SafeReplace">1</ArmorRating_Sharp>
			</statBases>
		</value>
	</Operation>
	<!-- Medium -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[@Name="BaseMechanoidWalker"]</xpath>
		<value>
			<statBases Operation="Safe">
				<ArmorRating_Blunt Operation="SafeReplace">0.3</ArmorRating_Blunt>
				<ArmorRating_Sharp Operation="SafeReplace">0.6</ArmorRating_Sharp>
			</statBases>
		</value>
	</Operation>
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Mech_Termite"]</xpath>
		<value>
			<statBases Operation="Safe">
				<ArmorRating_Blunt Operation="SafeReplace">0.4</ArmorRating_Blunt>
				<ArmorRating_Sharp Operation="SafeReplace">0.8</ArmorRating_Sharp>
			</statBases>
		</value>
	</Operation>

	<!-- Biotech -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>ludeon.rimworld.biotech</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[@Name="HeavyMechanoid"]</xpath>
				<value>
					<statBases Operation="Safe">
						<ArmorRating_Blunt Operation="SafeReplace">0.5</ArmorRating_Blunt>
						<ArmorRating_Sharp Operation="SafeReplace">1</ArmorRating_Sharp>
					</statBases>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="Mech_Tunneler"]</xpath>
				<value>
					<statBases Operation="Safe">
						<ArmorRating_Blunt Operation="SafeReplace">0.6</ArmorRating_Blunt>
						<ArmorRating_Sharp Operation="SafeReplace">1.2</ArmorRating_Sharp>
					</statBases>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[@Name="LightMechanoid"]</xpath>
				<value>
					<statBases Operation="Safe">
						<ArmorRating_Blunt Operation="SafeReplace">0.1</ArmorRating_Blunt>
						<ArmorRating_Sharp Operation="SafeReplace">0.2</ArmorRating_Sharp>
					</statBases>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[@Name="SuperHeavyMechanoid"]</xpath>
				<value>
					<statBases Operation="Safe">
						<ArmorRating_Blunt Operation="SafeReplace">0.6</ArmorRating_Blunt>
						<ArmorRating_Sharp Operation="SafeReplace">1.2</ArmorRating_Sharp>
					</statBases>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="Mech_Apocriton"]</xpath>
				<value>
					<statBases Operation="Safe">
						<ArmorRating_Blunt Operation="SafeReplace">0.7</ArmorRating_Blunt>
						<ArmorRating_Sharp Operation="SafeReplace">1.4</ArmorRating_Sharp>
					</statBases>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
