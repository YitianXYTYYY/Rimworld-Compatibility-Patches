<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>vanillaracesexpanded.hussar</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- weapon aptitude -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/GeneDef[defName="VREHT_WeaponAptitude_Randomizer"]</xpath>
				<value>
					<biostatCpx Operation="SafeAdd">0</biostatCpx>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>hussars.blablabla.cantbearsedtocomeupwithafunnyid</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneDef[defName="SEX_RangedWeaponAptitude"]</xpath>
						<value>
							<displayCategory Operation="AddOrReplace">Violence_Ranged</displayCategory>
							<displayOrderInCategory Operation="AddOrReplace">-100</displayOrderInCategory>
							<exclusionTags Operation="Safe">
								<li Operation="SafeAdd" Compare="InnerText">SEX_WeaponAptitude</li>
							</exclusionTags>
							<statFactors Operation="Safe">
								<ShootingAccuracyPawn Operation="SafeRemove">0</ShootingAccuracyPawn>
							</statFactors>
							<statOffsets Operation="Safe">
								<ShootingAccuracyPawn Operation="SafeAdd">12</ShootingAccuracyPawn>
							</statOffsets>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneDef[defName="SEX_MeleeWeaponAptitude"]</xpath>
						<value>
							<displayCategory Operation="AddOrReplace">Violence_Melee</displayCategory>
							<displayOrderInCategory Operation="AddOrReplace">-100</displayOrderInCategory>
							<exclusionTags Operation="Safe">
								<li Operation="SafeAdd" Compare="InnerText">SEX_WeaponAptitude</li>
							</exclusionTags>
							<statFactors Operation="Safe">
								<MeleeHitChance Operation="SafeRemove">0</MeleeHitChance>
							</statFactors>
							<statOffsets Operation="Safe">
								<MeleeHitChance Operation="SafeAdd">12</MeleeHitChance>
							</statOffsets>
						</value>
					</Operation>
				</caseTrue>
			</Operation>

			<!-- 0 misc -->
			<Operation Class="XmlExtensions.SetScope">
				<xpath>Defs/GeneDef[defName="VREH_Giant"]</xpath>
				<apply>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>GeneDef</xpath>
						<value>
							<biostatMet Operation="SafeReplace">-2</biostatMet>
							<capMods Operation="Safe">
								<li Operation="SafeAdd" Compare="InnerText" XPathLocal="capacity">
									<capacity>Moving</capacity>
									<offset>-0.1</offset>
								</li>
							</capMods>
							<statFactors Operation="Safe">
								<VEF_BodySize_Multiplier Operation="SafeRemove">0</VEF_BodySize_Multiplier>
							</statFactors>
							<statOffsets Operation="Safe">
								<VEF_BodySize_Offset Operation="SafeAdd">0.4</VEF_BodySize_Offset>
							</statOffsets>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.FindMod">
						<mods>
							<li>vanillaquestsexpanded.ancients</li>
						</mods>
						<packageId>true</packageId>
						<caseTrue>
							<Operation Class="XmlExtensions.HybridPatch">
								<xpath>GeneDef</xpath>
								<value>
									<exclusionTags Operation="Safe">
										<li Operation="SafeAdd" Compare="InnerText">VQEA_Enormous_VREH_Giant</li>
									</exclusionTags>
								</value>
							</Operation>
						</caseTrue>
					</Operation>
				</apply>
			</Operation>

			<!-- -40 wing -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/GeneDef[defName="VREH_Glidewings"]</xpath>
				<value>
					<displayCategory Operation="AddOrReplace">Wings</displayCategory>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
