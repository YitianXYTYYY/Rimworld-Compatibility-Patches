<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Bodyparts -->
	<!-- bionic -->
	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/HediffDef[defName="BionicStomach"]</xpath>
		<apply>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>HediffDef/stages/li</xpath>
				<value>
					<foodPoisoningChanceFactor Operation="SafeRemove"/>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>mse2.core</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef</xpath>
						<value>
							<comps Operation="Safe">
								<li Class="MSE2.HediffCompProperties_ModuleHolder" Operation="SafeAdd" CheckAttributes="True">
									<maxModules>1</maxModules>
								</li>
							</comps>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</apply>
	</Operation>

	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>ludeon.rimworld.royalty</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- prosthetics -->
			<!-- archotech -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="PsychicSensitizer"]/stages/li</xpath>
				<value>
					<statOffsets Operation="Safe">
						<PsychicSensitivity Operation="SafeReplace">0.4</PsychicSensitivity>
					</statOffsets>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThoughtDef[defName="PsychicHarmonization"]/stages/li[label="psychic harmony: {HARMONIZER_labelShort}"]</xpath>
				<value>
					<statOffsets Operation="Safe">
						<baseMoodEffect Operation="SafeReplace">5</baseMoodEffect>
					</statOffsets>
				</value>
			</Operation>
			<!-- bionic -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="Immunoenhancer"]/stages/li</xpath>
				<value>
					<statOffsets Operation="Safe">
						<ImmunityGainSpeed Operation="SafeReplace">0.1</ImmunityGainSpeed>
					</statOffsets>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="HealingEnhancer"]/stages/li</xpath>
				<value>
					<naturalHealingFactor Operation="SafeRemove"/>
					<statFactors Operation="Safe">
						<InjuryHealingFactor Operation="SafeRemove">0</InjuryHealingFactor>
					</statFactors>
					<statOffsets Operation="Safe">
						<InjuryHealingFactor Operation="SafeAdd">1</InjuryHealingFactor>
					</statOffsets>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="ToughskinGland"]/stages/li</xpath>
				<value>
					<capMods Operation="Safe">
						<li Operation="Safe" Compare="InnerText" XPathLocal="capacity">
							<capacity Operation="Safe">Moving</capacity>
							<offset Operation="SafeAdd">-0.1</offset>
							<postFactor Operation="SafeRemove">0</postFactor>
						</li>
					</capMods>
					<statOffsets Operation="Safe">
						<ArmorRating_Sharp Operation="SafeReplace">0.4</ArmorRating_Sharp>
						<ArmorRating_Blunt Operation="SafeReplace">0.2</ArmorRating_Blunt>
					</statOffsets>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="ArmorskinGland"]/stages/li</xpath>
				<value>
					<capMods Operation="Safe">
						<li Operation="Safe" Compare="InnerText" XPathLocal="capacity">
							<capacity Operation="Safe">Moving</capacity>
							<offset Operation="SafeAdd">-0.15</offset>
							<postFactor Operation="SafeRemove">0</postFactor>
						</li>
					</capMods>
					<statOffsets Operation="Safe">
						<ArmorRating_Sharp Operation="SafeReplace">0.5</ArmorRating_Sharp>
						<ArmorRating_Blunt Operation="SafeReplace">0.3</ArmorRating_Blunt>
					</statOffsets>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="StoneskinGland"]/stages/li</xpath>
				<value>
					<capMods Operation="Safe">
						<li Operation="Safe" Compare="InnerText" XPathLocal="capacity">
							<capacity Operation="Safe">Moving</capacity>
							<offset Operation="SafeAdd">-0.2</offset>
							<postFactor Operation="SafeRemove">0</postFactor>
						</li>
					</capMods>
					<statOffsets Operation="Safe">
						<ArmorRating_Sharp Operation="SafeReplace">0.6</ArmorRating_Sharp>
						<ArmorRating_Blunt Operation="SafeReplace">0.4</ArmorRating_Blunt>
					</statOffsets>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="CircadianAssistant"]/stages/li</xpath>
				<value>
					<statFactors Operation="Safe">
						<RestFallRateFactor Operation="SafeAdd">0.8</RestFallRateFactor>
					</statFactors>
					<statOffsets Operation="Safe">
						<RestFallRateFactor Operation="SafeRemove">0</RestFallRateFactor>
					</statOffsets>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>mse2.core</li>
				</mods>
				<packageId>true</packageId>
				<caseFalse>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/HediffDef[defName="ReprocessorStomach"]/stages/li</xpath>
						<value>
							<hungerRateFactor Operation="Safe">0.8</hungerRateFactor>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/HediffDef[defName="NuclearStomach"]/stages/li</xpath>
						<value>
							<hungerRateFactor Operation="Safe">0.2</hungerRateFactor>
						</value>
					</Operation>
				</caseFalse>
				<caseTrue>
					<Operation Class="XmlExtensions.PatchOperationSafeRemove">
						<xpath>Defs/HediffDef[(defName="DetoxifierStomach" or defName="ReprocessorStomach" or defName="NuclearStomach") and @ParentName!="MSE_ModuleAddedBionic"]</xpath>
					</Operation>
					<Operation Class="XmlExtensions.PatchOperationSafeRemove">
						<xpath>Defs/ThingDef[(defName="DetoxifierStomach" or defName="ReprocessorStomach" or defName="NuclearStomach") and @ParentName!="MSE_ModuleBionic"]</xpath>
					</Operation>
					<Operation Class="XmlExtensions.PatchOperationSafeRemove">
						<xpath>Defs/RecipeDef[(defName="InstallDetoxifierStomach" or defName="InstallReprocessorStomach" or defName="InstallNuclearStomach") and @ParentName!="MSE_SurgeryInstallModuleBase"]</xpath>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

	<Operation Class="XmlExtensions.FindMod">
