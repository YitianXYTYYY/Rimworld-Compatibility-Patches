<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Odyssey -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>ludeon.rimworld.odyssey</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="PatchOperationAdd">
				<xpath>Defs/PawnKindDef[@Name="TradersGuildGunnerBase" or @Name="TradersGuild_Slasher"]</xpath>
				<value>
					<itemQuality>Excellent</itemQuality>
				</value>
			</Operation>
			<Operation Class="PatchOperationAdd">
				<xpath>Defs/PawnKindDef[@Name="TradersGuildEliteTierBase"]</xpath>
				<value>
					<itemQuality>Masterwork</itemQuality>
					<maxApparelQuality>Masterwork</maxApparelQuality>
				</value>
			</Operation>
			<Operation Class="PatchOperationReplace">
				<xpath>Defs/PawnKindDef[defName="Salvager_Pirate"]/skills</xpath>
				<value>
					<skills>
						<li>
							<skill>Shooting</skill>
							<range>7~14</range>
						</li>
					</skills>
				</value>
			</Operation>
			<Operation Class="PatchOperationReplace">
				<xpath>Defs/PawnKindDef[@Name="TradersGuildEliteBase"]/skills</xpath>
				<value>
					<skills>
						<li>
							<skill>Shooting</skill>
							<range>13~18</range>
						</li>
					</skills>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Vanilla Factions Expanded - Empire -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>oskarpotocki.vfe.empire</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/PawnKindDef[@Name="VFEE_DeserterBase"]</xpath>
				<value>
					<itemQuality Operation="SafeReplace">Excellent</itemQuality>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaracesexpanded.hussar</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/FactionDef[defName="VFEE_Deserters"]/pawnGroupMakers/li[position()=1 or position()=2]/options</xpath>
						<value>
							<TMM_Deserter_Uhlan Operation="SafeAdd">1.2</TMM_Deserter_Uhlan>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaracesexpanded.sanguophage</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/PawnKindDef[defName="VFEE_Empire_Royal_Archcount" or 
							defName="VFEE_Empire_Royal_Marquess" or 
							defName="VFEE_Empire_Royal_Archduke" or 
							defName="VFEE_Empire_Royal_Magister" or 
							defName="VFEE_Empire_Royal_Despot"]/xenotypeSet/xenotypeChances</xpath>
						<value>
							<VRE_Bruxa Operation="SafeAdd">0.04</VRE_Bruxa>
							<VRE_Strigoi Operation="SafeAdd">0.04</VRE_Strigoi>
							<VRE_Ekkimian Operation="SafeAdd">0.04</VRE_Ekkimian>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/PawnKindDef[defName="VFEE_Empire_Royal_HighStellarch" or 
							defName="Empire_Royal_Stellarch"]/xenotypeSet/xenotypeChances</xpath>
						<value>
							<VRE_Bruxa Operation="SafeAdd">0.04</VRE_Bruxa>
							<VRE_Strigoi Operation="SafeAdd">0.04</VRE_Strigoi>
							<VRE_Ekkimian Operation="SafeAdd">0.04</VRE_Ekkimian>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
