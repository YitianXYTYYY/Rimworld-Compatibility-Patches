<?xml version="1.0" encoding="utf-8"?>
<Patch>	

	<!-- Vanilla Genetics Expanded -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>vanillaexpanded.vgeneticse</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/TraderKindDef[defName="GR_OrbitalTrader"]/stockGenerators</xpath>
				<value>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>Genepack</thingDef>
						<countRange>4~6</countRange>
					</li>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>ArchiteCapsule</thingDef>
						<countRange>0~5</countRange>
					</li>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>DeathrestCapacitySerum</thingDef>
						<countRange>0~1</countRange>
					</li>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Yayo's Combat 3 (Continued) -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>mlie.yayoscombat3</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- Ammo Trade -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/TraderKindDef[not(orbital="true")]/stockGenerators[li[tradeTag="WeaponRanged" and maxTechLevelGenerate="Neolithic"]]</xpath>
				<value>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>AmmoPrimitive</thingDef>
						<countRange>30~300</countRange>
					</li>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>Pila</thingDef>
						<countRange>10~30</countRange>
					</li>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/TraderKindDef[not(orbital="true")]/stockGenerators[li[tradeTag="WeaponRanged" and not(maxTechLevelGenerate="Neolithic" or weaponTag="SpacerGun")]]</xpath>
				<value>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>AmmoIndustrial</thingDef>
						<countRange>45~450</countRange>
					</li>
					<li Class="StockGenerator_Category" Operation="Add">
						<categoryDef>yy_ammo_category</categoryDef>
						<thingDefCountRange>1~3</thingDefCountRange>
						<countRange>15~150</countRange>
						<excludedThingDefs>
							<li>AmmoPrimitive</li>
							<li>AmmoIndustrial</li>
						</excludedThingDefs>
					</li>
					<li Class="StockGenerator_Category" Operation="Add">
						<categoryDef>Grenades</categoryDef>
						<thingDefCountRange>1~5</thingDefCountRange>
						<countRange>1~10</countRange>
					</li>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/TraderKindDef[not(orbital="true")]/stockGenerators[li[tradeTag="WeaponRanged" and weaponTag="SpacerGun"]]</xpath>
				<value>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>AmmoIndustrial</thingDef>
						<countRange>30~300</countRange>
					</li>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>AmmoSpacer</thingDef>
						<countRange>30~300</countRange>
					</li>
					<li Class="StockGenerator_Category" Operation="Add">
						<categoryDef>yy_ammo_category</categoryDef>
						<thingDefCountRange>1~3</thingDefCountRange>
						<countRange>15~150</countRange>
						<excludedThingDefs>
							<li>AmmoPrimitive</li>
							<li>AmmoIndustrial</li>
							<li>AmmoSpacer</li>
						</excludedThingDefs>
					</li>
					<li Class="StockGenerator_Category" Operation="Add">
						<categoryDef>Grenades</categoryDef>
						<thingDefCountRange>2~5</thingDefCountRange>
						<countRange>1~10</countRange>
					</li>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/TraderKindDef[orbital="true"]/stockGenerators[li[tradeTag="WeaponRanged"]]</xpath>
				<value>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>AmmoIndustrial</thingDef>
						<countRange>150~750</countRange>
					</li>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>AmmoSpacer</thingDef>
						<countRange>150~450</countRange>
					</li>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>AmmoSpacerEMP</thingDef>
						<countRange>150~300</countRange>
					</li>
					<li Class="StockGenerator_Category" Operation="Add">
						<categoryDef>yy_ammo_category</categoryDef>
						<thingDefCountRange>2~4</thingDefCountRange>
						<countRange>15~150</countRange>
						<excludedThingDefs>
							<li>AmmoPrimitive</li>
							<li>AmmoIndustrial</li>
							<li>AmmoSpacer</li>
							<li>AmmoSpacerEMP</li>
						</excludedThingDefs>
					</li>
					<li Class="StockGenerator_Category" Operation="Add">
						<categoryDef>Grenades</categoryDef>
						<thingDefCountRange>3~5</thingDefCountRange>
						<countRange>5~15</countRange>
					</li>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>teiwaz.gtgot</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/TraderKindDef[defName="Orbital_GTGMilitaryCorporation"]/stockGenerators</xpath>
						<value>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_GlobalSingleDef" Operation="Add">
								<thingDef>AmmoIndustrial</thingDef>
								<countRange>900~3000</countRange>
							</li>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_GlobalSingleDef" Operation="Add">
								<thingDef>AmmoSpacer</thingDef>
								<countRange>600~1800</countRange>
							</li>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_GlobalSingleDef" Operation="Add">
								<thingDef>AmmoSpacerEMP</thingDef>
								<countRange>300~1200</countRange>
							</li>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_GlobalCategory" Operation="Add">
								<categoryDef>yy_ammo_category</categoryDef>
								<thingDefCountRange>2~5</thingDefCountRange>
								<countRange>150~600</countRange>
								<excludedThingDefs>
									<li>AmmoPrimitive</li>
									<li>AmmoIndustrial</li>
									<li>AmmoSpacer</li>
									<li>AmmoSpacerEMP</li>
								</excludedThingDefs>
							</li>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_GlobalCategory" Operation="Add">
								<categoryDef>Grenades</categoryDef>
								<thingDefCountRange>3~6</thingDefCountRange>
								<countRange>10~50</countRange>
							</li>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/TraderKindDef[defName="Orbital_GTGBlackMarket"]/stockGenerators</xpath>
						<value>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_GlobalSingleDef" Operation="Add">
								<thingDef>AmmoIndustrial</thingDef>
								<countRange>150~900</countRange>
							</li>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_GlobalSingleDef" Operation="Add">
								<thingDef>AmmoSpacer</thingDef>
								<countRange>150~450</countRange>
							</li>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_GlobalCategory" Operation="Add">
								<categoryDef>yy_ammo_category</categoryDef>
								<thingDefCountRange>2~5</thingDefCountRange>
								<countRange>50~150</countRange>
								<excludedThingDefs>
									<li>AmmoPrimitive</li>
									<li>AmmoIndustrial</li>
									<li>AmmoSpacer</li>
								</excludedThingDefs>
							</li>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_GlobalCategory" Operation="Add">
								<categoryDef>Grenades</categoryDef>
								<thingDefCountRange>2~5</thingDefCountRange>
								<countRange>5~25</countRange>
							</li>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
