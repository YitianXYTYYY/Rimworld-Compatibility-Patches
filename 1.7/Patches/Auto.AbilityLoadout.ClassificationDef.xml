<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>dreadarm.abilityloadout</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.SetScope">
				<xpath>Defs/Dreadarm.AbilityLoadout.AbilityLoadoutClassificationDef[defName="AbilityLoadout_CoreAndDlcClassifications"]/entries</xpath>
				<apply>
					<!-- [FSF] More Psycast Powers -->
					<Operation Class="XmlExtensions.FindMod">
						<mods>
							<li>frozensnowfox.morepsycastpowers</li>
						</mods>
						<packageId>true</packageId>
						<caseTrue>
							<Operation Class="PatchOperationAdd">
								<xpath>entries</xpath>
								<value>
									<li>
										<targetDefName>FSFArcticPinhole</targetDefName>
										<category>Utility</category>
										<neverAutoFire>true</neverAutoFire>
									</li>
									<li><targetDefName>FSFDisarm</targetDefName><category>Offensive</category></li>
									<li><targetDefName>FSFElementalShield</targetDefName><category>Support</category></li>
									<li>
										<targetDefName>FSFEMPPulse</targetDefName>
										<category>Offensive</category>
										<friendlyFireRisk>true</friendlyFireRisk>
									</li>
									<li><targetDefName>FSFEntomb</targetDefName><category>Offensive</category></li>
									<li>
										<targetDefName>FSFFirestorm</targetDefName>
										<category>Dangerous</category>
										<friendlyFireRisk>true</friendlyFireRisk>
									</li>
									<li>
										<targetDefName>FSFFlamebolt</targetDefName>
										<category>Offensive</category>
										<friendlyFireRisk>true</friendlyFireRisk>
									</li>
									<li><targetDefName>FSFFracture</targetDefName><category>Offensive</category></li>
									<li><targetDefName>FSFFrostbite</targetDefName><category>Offensive</category></li>
									<li><targetDefName>FSFMassInvisibility</targetDefName><category>Defensive</category></li>
									<li>
										<targetDefName>FSFMassSkip</targetDefName>
										<category>Movement</category>
										<neverAutoFire>true</neverAutoFire>
									</li>
									<li><targetDefName>FSFPsyblade</targetDefName><category>Support</category></li>
									<li><targetDefName>FSFPsychicShock</targetDefName><category>Offensive</category></li>
									<li><targetDefName>FSFStasis</targetDefName><category>Utility</category></li>
									<li><targetDefName>FSFSteelskin</targetDefName><category>Support</category></li>
								</value>
							</Operation>
						</caseTrue>
					</Operation>
				</apply>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
