<?xml version="1.0" encoding="utf-8"?>
<Patch>	

	<!-- Vanilla Genetics Expanded -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>vanillaexpanded.vgeneticse</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/TraderKindDef[defName="GR_Outlander_CaravanTrader"]</xpath>
		<apply>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>TraderKindDef/stockGenerators/li[@Class="StockGenerator_SingleDef"][thingDef="Genepack"]</xpath>
				<caseFalse>
					<Operation Class="PatchOperationAdd">
						<xpath>TraderKindDef/stockGenerators</xpath>
						<value>
							<li Class="StockGenerator_SingleDef" MayRequire="ludeon.rimworld.biotech">
								<thingDef>Genepack</thingDef>
								<countRange>1~1</countRange>
							</li>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>TraderKindDef/stockGenerators/li[@Class="StockGenerator_SingleDef"][thingDef="ArchiteCapsule"]</xpath>
				<caseFalse>
					<Operation Class="PatchOperationAdd">
						<xpath>TraderKindDef/stockGenerators</xpath>
						<value>
							<li Class="StockGenerator_SingleDef" MayRequire="ludeon.rimworld.biotech">
								<thingDef>ArchiteCapsule</thingDef>
								<countRange>-8~1</countRange>
							</li>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>TraderKindDef/stockGenerators/li[@Class="StockGenerator_SingleDef"][thingDef="DeathrestCapacitySerum"]</xpath>
				<caseFalse>
					<Operation Class="PatchOperationAdd">
						<xpath>TraderKindDef/stockGenerators</xpath>
						<value>
							<li Class="StockGenerator_SingleDef" MayRequire="ludeon.rimworld.biotech">
								<thingDef>DeathrestCapacitySerum</thingDef>
								<countRange>0~1</countRange>
							</li>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
			<Operation Class="XmlExtensions.OptionalPatch">
				<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
				<key>FSFMoreGenepacksOnTradersOn</key>
				<defaultValue>false</defaultValue>
				<caseTrue>	
					<Operation Class="XmlExtensions.UseSettings">
						<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
						<keys>
							<li>FSFMoreGenepacksOnTradersGenepackMin</li>
							<li>FSFMoreGenepacksOnTradersGenepackMax</li>
							<li>FSFMoreGenepacksOnTradersArchiteCapulesMin</li>
							<li>FSFMoreGenepacksOnTradersArchiteCapulesMax</li>
						</keys>
						<defaultValues>
							<li>5</li>
							<li>6</li>
							<li>6</li>
							<li>7</li>
						</defaultValues>
						<apply>
							<Operation Class="PatchOperationReplace">
								<xpath>TraderKindDef/stockGenerators/li[@Class="StockGenerator_SingleDef"][thingDef="Genepack"]/countRange</xpath>
								<value>
									<countRange>{FSFMoreGenepacksOnTradersGenepackMin}~{FSFMoreGenepacksOnTradersGenepackMax}</countRange>
								</value>
							</Operation>
							<Operation Class="PatchOperationReplace">
								<xpath>TraderKindDef/stockGenerators/li[@Class="StockGenerator_SingleDef"][thingDef="ArchiteCapsule"]/countRange</xpath>
								<value>
									<countRange Operation="SafeReplace">{FSFMoreGenepacksOnTradersArchiteCapulesMin}~{FSFMoreGenepacksOnTradersArchiteCapulesMax}</countRange>
								</value>
							</Operation>
							<Operation Class="XmlExtensions.Conditional">
								<xpath>TraderKindDef/stockGenerators/li[@Class="StockGenerator_SingleDef"][thingDef="AG_Alphapack"]</xpath>
								<caseFalse>
									<Operation Class="XmlExtensions.HybridPatch">
										<xpath>TraderKindDef/stockGenerators</xpath>
										<value>
											<li Class="StockGenerator_SingleDef" MayRequire="sarg.alphagenes" Operation="Add">
												<thingDef>AG_Alphapack</thingDef>
												<countRange>1</countRange>
											</li>
										</value>
									</Operation>
								</caseFalse>
							</Operation>
							<Operation Class="XmlExtensions.Conditional">
								<xpath>TraderKindDef/stockGenerators/li[@Class="StockGenerator_SingleDef"][thingDef="AG_Mixedpack"]</xpath>
								<caseFalse>
									<Operation Class="XmlExtensions.HybridPatch">
										<xpath>TraderKindDef/stockGenerators</xpath>
										<value>
											<li Class="StockGenerator_SingleDef" MayRequire="sarg.alphagenes" Operation="Add">
												<thingDef>AG_Mixedpack</thingDef>
												<countRange>1</countRange>
											</li>
										</value>
									</Operation>
								</caseFalse>
							</Operation>
						</apply>
					</Operation>
				</caseTrue>
			</Operation>
		</apply>
	</Operation>
	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/TraderKindDef[defName="GR_OrbitalTrader"]</xpath>
		<apply>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>TraderKindDef/stockGenerators/li[@Class="StockGenerator_SingleDef"][thingDef="Genepack"]</xpath>
				<caseFalse>
					<Operation Class="PatchOperationAdd">
						<xpath>TraderKindDef/stockGenerators</xpath>
						<value>
							<li Class="StockGenerator_SingleDef" MayRequire="ludeon.rimworld.biotech">
								<thingDef>Genepack</thingDef>
								<countRange>1~1</countRange>
							</li>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>TraderKindDef/stockGenerators/li[@Class="StockGenerator_SingleDef"][thingDef="ArchiteCapsule"]</xpath>
				<caseFalse>
					<Operation Class="PatchOperationAdd">
						<xpath>TraderKindDef/stockGenerators</xpath>
						<value>
							<li Class="StockGenerator_SingleDef" MayRequire="ludeon.rimworld.biotech">
								<thingDef>ArchiteCapsule</thingDef>
								<countRange>-8~1</countRange>
							</li>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>TraderKindDef/stockGenerators/li[@Class="StockGenerator_SingleDef"][thingDef="DeathrestCapacitySerum"]</xpath>
				<caseFalse>
					<Operation Class="PatchOperationAdd">
						<xpath>TraderKindDef/stockGenerators</xpath>
						<value>
							<li Class="StockGenerator_SingleDef" MayRequire="ludeon.rimworld.biotech">
								<thingDef>DeathrestCapacitySerum</thingDef>
								<countRange>0~1</countRange>
							</li>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
			<Operation Class="XmlExtensions.OptionalPatch">
				<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
				<key>FSFMoreGenepacksOnTradersOn</key>
				<defaultValue>false</defaultValue>
				<caseTrue>	
					<Operation Class="XmlExtensions.UseSettings">
						<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
						<keys>
							<li>FSFMoreGenepacksOnTradersGenepackMin</li>
							<li>FSFMoreGenepacksOnTradersGenepackMax</li>
							<li>FSFMoreGenepacksOnTradersArchiteCapulesMin</li>
							<li>FSFMoreGenepacksOnTradersArchiteCapulesMax</li>
						</keys>
						<defaultValues>
							<li>5</li>
							<li>6</li>
							<li>6</li>
							<li>7</li>
						</defaultValues>
						<apply>
							<Operation Class="PatchOperationReplace">
								<xpath>TraderKindDef/stockGenerators/li[@Class="StockGenerator_SingleDef"][thingDef="Genepack"]/countRange</xpath>
								<value>
									<countRange>{FSFMoreGenepacksOnTradersGenepackMin}~{FSFMoreGenepacksOnTradersGenepackMax}</countRange>
								</value>
							</Operation>
							<Operation Class="PatchOperationReplace">
								<xpath>TraderKindDef/stockGenerators/li[@Class="StockGenerator_SingleDef"][thingDef="ArchiteCapsule"]/countRange</xpath>
								<value>
									<countRange Operation="SafeReplace">{FSFMoreGenepacksOnTradersArchiteCapulesMin}~{FSFMoreGenepacksOnTradersArchiteCapulesMax}</countRange>
								</value>
							</Operation>
							<Operation Class="XmlExtensions.Conditional">
								<xpath>TraderKindDef/stockGenerators/li[@Class="StockGenerator_SingleDef"][thingDef="AG_Alphapack"]</xpath>
								<caseFalse>
									<Operation Class="XmlExtensions.HybridPatch">
										<xpath>TraderKindDef/stockGenerators</xpath>
										<value>
											<li Class="StockGenerator_SingleDef" MayRequire="sarg.alphagenes" Operation="Add">
												<thingDef>AG_Alphapack</thingDef>
												<countRange>1</countRange>
											</li>
										</value>
									</Operation>
								</caseFalse>
							</Operation>
							<Operation Class="XmlExtensions.Conditional">
								<xpath>TraderKindDef/stockGenerators/li[@Class="StockGenerator_SingleDef"][thingDef="AG_Mixedpack"]</xpath>
								<caseFalse>
									<Operation Class="XmlExtensions.HybridPatch">
										<xpath>TraderKindDef/stockGenerators</xpath>
										<value>
											<li Class="StockGenerator_SingleDef" MayRequire="sarg.alphagenes" Operation="Add">
												<thingDef>AG_Mixedpack</thingDef>
												<countRange>1</countRange>
											</li>
										</value>
									</Operation>
								</caseFalse>
							</Operation>
						</apply>
					</Operation>
				</caseTrue>
			</Operation>
		</apply>
	</Operation>
		</caseTrue>
	</Operation>

</Patch>
