<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="PatchOperationSequence">
		<operations>

			<li Class="PatchOperationFindMod">
				<mods>
					<li>Ideology</li>
				</mods>
				<match Class="PatchOperationSequence">
					<operations>
						<li Class="PatchOperationConditional">
							<xpath>Defs/MemeDef[defName="Cannibal"]/label</xpath>
							<match Class="PatchOperationReplace">
								<xpath>Defs/MemeDef[defName="Cannibal"]/label</xpath>
								<value>
									<label>cannibalism</label>
								</value>
							</match>
						</li>
					</operations>
				</match>
			</li>

			<li Class="PatchOperationFindMod">
				<mods>
					<li>Alpha Genes</li>
					<li>Vanilla Races Expanded - Pigskin</li>
					<li>Vanilla Races Expanded - Insector</li>
				</mods>
				<match Class="PatchOperationFindMod">
					<mods>
						<li>Ideology</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationReplace">
								<xpath>Defs/ThoughtDef[defName="AteHumanMeat_Abhorrent" or defName="AteHumanMeat_Know_Abhorrent" or defName="AteHumanMeat_Horrible" or defName="AteHumanMeat_Know_Horrible" or defName="AteHumanMeat_Disapproved" or defName="AteHumanMeat_Know_Disapproved" or defName="AteHumanMeat_Preferred" or defName="AteHumanMeat_RequiredStrong" or defName="AteHumanMeat_RequiredRavenous"]/stages/li/label</xpath>
								<value>
									<label>committed cannibalism</label>
								</value>
							</li>
							<li Class="PatchOperationReplace">
								<xpath>Defs/ThoughtDef[defName="NoRecentHumanMeat_Preferred" or defName="NoRecentHumanMeat_RequiredStrong" or defName="NoRecentHumanMeat_RequiredRavenous"]/stages/li/label</xpath>
								<value>
									<label>no recent cannibalism</label>
								</value>
							</li>
						</operations>
					</match>
				</match>
			</li>

			<li Class="PatchOperationFindMod">
				<mods>
					<li>Vanilla Backstories Expanded</li>
				</mods>
				<match Class="PatchOperationSequence">
					<operations>
						<li Class="PatchOperationReplace">
							<xpath>Defs/BackstoryDef[defName="VBE_AnomalousCreatureResearcher"]/baseDesc</xpath>
							<value>
								<baseDesc>Part of a secret organization dedicated to the capture and study of phenomena deemed "anomalous", [PAWN_nameDef] was part of a department dedicated to the capture and study of anomalous creatures. After one too many containment breaches, [PAWN_nameDef] was left traumatized, and left the organization.</baseDesc>
							</value>
						</li>
					</operations>
				</match>
			</li>

