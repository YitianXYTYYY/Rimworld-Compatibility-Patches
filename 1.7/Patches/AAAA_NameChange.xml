						<li Class="PatchOperationReplace">
							<xpath>Defs/ThingDef[defName="GR_RodentGenetic"]/label</xpath>
							<value>
								<label>rodent genome</label>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/RecipeDef[defName="GR_CraftThrumboSkin"]/jobString</xpath>
