							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/RecipeDef[defName="GR_GenoframeAwfulRecipe"]/label</xpath>
							<value>
								<label>make genoframe (awful)</label>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/RecipeDef[defName="GR_GenoframePoorRecipe"]/label</xpath>
