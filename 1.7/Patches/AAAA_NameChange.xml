						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/HediffDef[defName="GR_BearMuscleTissue"]/description</xpath>
							<value>
								<description>Grafts of bear muscle tissue on the subject's torso increase manipulation.</description>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/HediffDef[defName="GR_HibernationModule"]/description</xpath>
							<value>
								<description>A biochip that modifies the brain to increase consciousness and reduce the need for sleep.</description>
