						<li Class="PatchOperationReplace">
							<xpath>Defs/ThingDef[defName="GR_GenoframeMasterwork"]/label</xpath>
							<value>
								<label>genoframe (masterwork)</label>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/ThingDef[defName="GR_GenoframeLegendary"]/label</xpath>
							<value>
								<label>genoframe (legendary)</label>
							</value>
						</li>
					</operations>
				</match>
			</li>

			<li Class="PatchOperationFindMod">
				<mods>
					<li>Vanilla Races Expanded - Pigskin</li>
				</mods>
				<match Class="PatchOperationSequence">
					<operations>
						<li Class="PatchOperationReplace">
							<xpath>Defs/GeneDef[defName="VRE_ChocolateSkin"]/label</xpath>
							<value>
								<label>chocolate skin</label>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/GeneDef[defName="VRE_HazelnutSkin"]/label</xpath>
							<value>
								<label>hazelnut skin</label>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/GeneDef[defName="VRE_AuburnSkin"]/label</xpath>
							<value>
								<label>auburn skin</label>
							</value>
						</li>
					</operations>
				</match>
			</li>

			<li Class="PatchOperationFindMod">
				<mods>
					<li>Biotech</li>
				</mods>
				<match Class="PatchOperationSequence">
					<operations>
						<li Class="PatchOperationReplace">
							<xpath>Defs/GeneTemplateDef[defName="AddictionResistant"]/label</xpath>
							<value>
								<label>{0} resistance</label>
							</value>
						</li>
						<li Class="PatchOperationReplace">
							<xpath>Defs/GeneDef[defName="FireResistant"]/label</xpath>
							<value>
								<label>fire resistance</label>
							</value>
						</li>
						<li Class="PatchOperationFindMod">
							<mods>
								<li>Odyssey</li>
							</mods>
							<match Class="PatchOperationSequence">
								<operations>
									<li Class="PatchOperationReplace">
										<xpath>Defs/GeneDef[defName="VacuumResistance_Partial"]/label</xpath>
										<value>
											<label>vacuum resistance</label>
										</value>
									</li>
								</operations>
							</match>
						</li>
					</operations>
				</match>
