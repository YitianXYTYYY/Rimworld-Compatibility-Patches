<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Big and Small - Framework -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>redmattis.betterprerequisites</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/ResearchProjectDef[defName="BS_AndroidConversion"]</xpath>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Glass Roofs -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>wailor.glassroofs</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ResearchProjectDef[defName="GR_Glassworks"]</xpath>
				<value>
					<prerequisites Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">Electricity</li>
						<li Operation="SafeAdd" Compare="InnerText">Smithing</li>
						<li Operation="SafeRemove" Compare="InnerText">Stonecutting</li>
					</prerequisites>
					<techLevel Operation="SafeReplace">Medieval</techLevel>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Odyssey Transport Shuttle -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>toshtaru.odyssey.transport.shuttle</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>ludeon.rimworld.biotech</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/ResearchProjectDef[defName="MechanitorShuttles"]</xpath>
						<value>
							<prerequisites Operation="Safe">
								<li Operation="SafeRemove" Compare="InnerText">Shuttles</li>
								<li Operation="SafeAdd" Compare="InnerText">TransportDrones</li>
							</prerequisites>
							<hiddenPrerequisites Operation="Safe">
								<li Operation="SafeAdd" Compare="InnerText">BasicMechtech</li>
							</hiddenPrerequisites>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Medical System Expansion 2 -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>mse2.core</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ResearchProjectDef[defName="BoneProstheticsSimple"]</xpath>
				<value>
					<prerequisites Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">Machining</li>
						<li Operation="SafeRemove" Compare="InnerText">Prosthetics</li>
					</prerequisites>
					<!--tab Operation="AddOrReplace">TechProsthetics</tab-->
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ResearchProjectDef[defName="BoneProstheticsPlasteel"]</xpath>
				<value>
					<prerequisites Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">BoneProstheticsSimple</li>
						<li Operation="SafeAdd" Compare="InnerText">Prosthetics</li>
					</prerequisites>
					<requiredResearchBuilding Operation="SafeAdd">HiTechResearchBench</requiredResearchBuilding>
					<requiredResearchFacilities Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">MultiAnalyzer</li>
					</requiredResearchFacilities>
					<!--tab Operation="AddOrReplace">TechProsthetics</tab-->
				</value>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/ThingDef/recipeMaker[researchPrerequisite="BionicModules"]</xpath>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/ResearchProjectDef[defName="BionicModules"]</xpath>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Gene Fabrication -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>amch.eragon.hcgenefabrication</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.SetScope">
				<xpath>Defs/ResearchProjectDef[defName="GeneFabrication"]</xpath>
				<apply>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>ResearchProjectDef</xpath>
						<value>
							<prerequisites Operation="Safe">
								<li Operation="SafeAdd" Compare="InnerText">Archogenetics</li>
								<li Operation="SafeRemove" Compare="InnerText">Fabrication</li>
								<li Operation="SafeRemove" Compare="InnerText">GeneProcessor</li>
							</prerequisites>
							<hiddenPrerequisites Operation="Safe">
								<li Operation="SafeAdd" Compare="InnerText">AdvancedFabrication</li>
							</hiddenPrerequisites>
							<requiredResearchBuilding Operation="SafeAdd">HiTechResearchBench</requiredResearchBuilding>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.FindMod">
						<mods>
							<li>vanillaexpanded.vgeneticse</li>
						</mods>
						<packageId>true</packageId>
						<caseTrue>
							<Operation Class="XmlExtensions.HybridPatch">
								<xpath>ResearchProjectDef</xpath>
								<value>
									<tab Operation="AddOrReplace">GR_GeneticReseach</tab>
								</value>
							</Operation>
						</caseTrue>
					</Operation>
				</apply>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Research Papers -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>chaoticenrico.researchpapers</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.SetScope">
				<xpath>Defs/ResearchProjectDef[defName="ResearchServerProject"]</xpath>
				<apply>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>ResearchProjectDef</xpath>
						<value>
							<prerequisites Operation="Safe">
								<li Operation="SafeRemove" Compare="InnerText">MicroelectronicsBasics</li>
							</prerequisites>
							<requiredResearchFacilities Operation="Safe">
								<li Operation="SafeAdd" Compare="InnerText">MultiAnalyzer</li>
							</requiredResearchFacilities>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.FindMod">
						<mods>
							<li>reel.expanded.storage</li>
						</mods>
						<packageId>true</packageId>
						<caseFalse>
							<Operation Class="XmlExtensions.HybridPatch">
								<xpath>ResearchProjectDef</xpath>
								<value>
									<prerequisites Operation="Safe">
										<li Operation="SafeAdd" Compare="InnerText">MultiAnalyzer</li>
									</prerequisites>
								</value>
							</Operation>
						</caseFalse>
						<caseTrue>
							<Operation Class="XmlExtensions.HybridPatch">
								<xpath>ResearchProjectDef</xpath>
								<value>
									<prerequisites Operation="Safe">
										<li Operation="SafeAdd" Compare="InnerText">ReelSpacerStorage</li>
									</prerequisites>
								</value>
							</Operation>
						</caseTrue>
					</Operation>
				</apply>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Security and Blast Doors Expanded -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>jarocks.securitydoorsexpanded</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/ThingDef/researchPrerequisites[li="SDE_ArmoredSecurityDoors"]</xpath>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/ResearchProjectDef[defName="SDE_ArmoredSecurityDoors"]</xpath>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Unique Weapons Unbound -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>shunter.uniqueweaponsunbound</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ResearchProjectDef[defName="UniqueMachining"]</xpath>
				<value>
					<prerequisites Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">Gunsmithing</li>
						<li Operation="SafeAdd" Compare="InnerText">Machining</li>
						<li Operation="SafeRemove" Compare="InnerText">UniqueSmithing</li>
					</prerequisites>
					<hiddenPrerequisites Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">UniqueSmithing</li>
					</hiddenPrerequisites>
					<requiredResearchBuilding Operation="SafeAdd">HiTechResearchBench</requiredResearchBuilding>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ResearchProjectDef[defName="UniqueFabrication"]</xpath>
				<value>
					<prerequisites Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">AdvancedFabrication</li>
						<li Operation="SafeRemove" Compare="InnerText">Fabrication</li>
						<li Operation="SafeRemove" Compare="InnerText">UniqueMachining</li>
					</prerequisites>
					<hiddenPrerequisites Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">UniqueMachining</li>
					</hiddenPrerequisites>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

