	<!-- 540 meat -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>vanillaracesexpanded.fungoid</li>
			<li>vanillaracesexpanded.insector</li>
			<li>vanillaracesexpanded.pigskin</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>ludeon.rimworld.ideology</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
								<xpath>Defs/ThoughtDef[defName="AteHumanMeat_Abhorrent" or 
									defName="AteHumanMeat_Know_Abhorrent" or 
									defName="AteHumanMeat_Horrible" or 
									defName="AteHumanMeat_Know_Horrible" or 
									defName="AteHumanMeat_Disapproved" or 
									defName="AteHumanMeat_Know_Disapproved" or 
									defName="AteHumanMeat_Preferred" or 
									defName="AteHumanMeat_RequiredStrong" or 
									defName="AteHumanMeat_RequiredRavenous"]/stages/li</xpath>
						<value>
							<label Operation="SafeReplace">committed cannibalism</label>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
								<xpath>Defs/ThoughtDef[defName="NoRecentHumanMeat_Preferred" or 
									defName="NoRecentHumanMeat_RequiredStrong" or 
									defName="NoRecentHumanMeat_RequiredRavenous"]/stages/li</xpath>
						<value>
							<label Operation="SafeReplace">no recent cannibalism</label>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaracesexpanded.pigskin</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneDef[defName="VRE_LowMeat"]</xpath>
						<value>
							<biostatCpx Operation="SafeRemove"/>
							<displayCategory Operation="AddOrReplace">MeatLeather</displayCategory>
							<displayOrderInCategory Operation="AddOrReplace">-100</displayOrderInCategory>
							<statFactors Operation="Safe">
								<MeatAmount Operation="SafeRemove">0</MeatAmount>
							</statFactors>
							<statOffsets Operation="Safe">
								<MeatAmount Operation="SafeAdd">-70</MeatAmount>
							</statOffsets>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneDef[defName="VRE_ExtraMeat"]</xpath>
						<value>
							<biostatCpx Operation="SafeRemove"/>
							<displayCategory Operation="AddOrReplace">MeatLeather</displayCategory>
							<displayOrderInCategory Operation="AddOrReplace">-90</displayOrderInCategory>
							<statFactors Operation="Safe">
								<MeatAmount Operation="SafeRemove">0</MeatAmount>
							</statFactors>
							<statOffsets Operation="Safe">
								<MeatAmount Operation="SafeAdd">70</MeatAmount>
							</statOffsets>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaracesexpanded.fungoid</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneDef[defName="VRE_FungalFlesh"]</xpath>
						<value>
							<displayCategory Operation="AddOrReplace">MeatLeather</displayCategory>
							<displayOrderInCategory Operation="AddOrReplace">100</displayOrderInCategory>
							<exclusionTags Operation="Safe">
								<li Operation="SafeAdd" Compare="InnerText">Flesh</li>
								<li Operation="SafeAdd" Compare="InnerText">Meat</li>
								<li Operation="SafeAdd" Compare="InnerText">AG_Meat</li>
							</exclusionTags>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaracesexpanded.insector</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneDef[defName="VRE_InsectFlesh"]</xpath>
						<value>
							<biostatCpx Operation="SafeRemove"/>
							<displayCategory Operation="AddOrReplace">MeatLeather</displayCategory>
							<displayOrderInCategory Operation="AddOrReplace">110</displayOrderInCategory>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaracesexpanded.pigskin</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneDef[defName="VRE_PorkFlesh"]</xpath>
						<value>
							<biostatCpx Operation="SafeRemove"/>
							<displayCategory Operation="AddOrReplace">MeatLeather</displayCategory>
							<displayOrderInCategory Operation="AddOrReplace">120</displayOrderInCategory>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneDef[defName="VRE_PigSkin"]</xpath>
						<value>
							<biostatCpx Operation="SafeRemove"/>
							<displayCategory Operation="AddOrReplace">MeatLeather</displayCategory>
							<displayOrderInCategory Operation="AddOrReplace">1000</displayOrderInCategory>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- 530 blood -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>vanillaracesexpanded.fungoid</li>
			<li>vanillaracesexpanded.genie</li>
			<li>vanillaracesexpanded.insector</li>
			<li>vanillaracesexpanded.phytokin</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaracesexpanded.genie</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneDef[defName="VRE_BlueBlood"]</xpath>
						<value>
							<biostatCpx Operation="SafeReplace">0</biostatCpx>
							<displayCategory Operation="AddOrReplace">Health_Blood</displayCategory>
							<displayOrderInCategory Operation="AddOrReplace">-100</displayOrderInCategory>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaracesexpanded.insector</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneDef[defName="VRE_BugBlood"]</xpath>
						<value>
							<biostatCpx Operation="SafeReplace">0</biostatCpx>
							<displayCategory Operation="AddOrReplace">Health_Blood</displayCategory>
							<displayOrderInCategory Operation="AddOrReplace">-90</displayOrderInCategory>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaracesexpanded.phytokin</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneDef[defName="VRE_SapBlood"]</xpath>
						<value>
							<customEffectDescriptions Operation="SafeAdd">
								<li>Bleed rate x50%</li>
							</customEffectDescriptions>
							<description Operation="SafeReplace">Carriers of this gene have thick, sticky, orange blood that greatly slows down their bleed out time.</description>
							<displayCategory Operation="AddOrReplace">Health_Blood</displayCategory>
							<displayOrderInCategory Operation="AddOrReplace">-80</displayOrderInCategory>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaracesexpanded.fungoid</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneDef[defName="VRE_RotBlood"]</xpath>
						<value>
							<displayCategory Operation="AddOrReplace">Health_Blood</displayCategory>
							<displayOrderInCategory Operation="AddOrReplace">-70</displayOrderInCategory>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaracesexpanded.genie</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneDef[defName="VRE_Hemophiliac"]</xpath>
						<value>
							<customEffectDescriptions Operation="SafeAdd">
								<li>Bleed rate x200%</li>
							</customEffectDescriptions>
							<displayCategory Operation="AddOrReplace">Health_Blood</displayCategory>
							<displayOrderInCategory Operation="AddOrReplace">100</displayOrderInCategory>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/GeneDef[defName="Superclotting"]</xpath>
				<value>
					<displayCategory Operation="AddOrReplace">Health_Blood</displayCategory>
					<displayOrderInCategory Operation="AddOrReplace">110</displayOrderInCategory>
					<exclusionTags Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">Superclotting</li>
					</exclusionTags>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- 110 skills -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>vanillaracesexpanded.fungoid</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/GeneDef[defName="VRE_NoStudy"]</xpath>
				<value>
					<displayOrderInCategory Operation="AddOrReplace">0</displayOrderInCategory>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
