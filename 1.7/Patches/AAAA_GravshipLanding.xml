<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Go Explore!</li>
        </mods>
        <match Class="PatchOperationFindMod">
            <mods>
                <li>Odyssey</li>
            </mods>
            <match Class="PatchOperationSequence">
                <operations>
                    <li Class="PatchOperationConditional">
                        <xpath>Defs/SitePartDef[defName="AmbrosiaAnimalsLGE"]/gravShipsCanLandOn</xpath>
                        <nomatch Class="PatchOperationAdd">
                            <xpath>Defs/SitePartDef[defName="AmbrosiaAnimalsLGE" or defName="PrisonCampLGE" or defName="ShipCoreStartupLGE"]</xpath>
                            <value>
                                <gravShipsCanLandOn>true</gravShipsCanLandOn>
                            </value>
                        </nomatch>
                    </li>
                </operations>
            </match>
        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Genetics Expanded</li>
        </mods>
        <match Class="PatchOperationFindMod">
            <mods>
                <li>Odyssey</li>
            </mods>
            <match Class="PatchOperationSequence">
                <operations>
                    <li Class="PatchOperationConditional">
                        <xpath>Defs/SitePartDef[defName="GR_AbandonedLab"]/gravShipsCanLandOn</xpath>
                        <nomatch Class="PatchOperationAdd">
                            <xpath>Defs/SitePartDef[defName="GR_AbandonedLab"]</xpath>
                            <value>
                                <gravShipsCanLandOn>true</gravShipsCanLandOn>
                            </value>
                        </nomatch>
                    </li>
                </operations>
            </match>
        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Quests Expanded - The Generator</li>
        </mods>
        <match Class="PatchOperationFindMod">
            <mods>
                <li>Odyssey</li>
            </mods>
            <match Class="PatchOperationSequence">
                <operations>
                    <li Class="PatchOperationConditional">
                        <xpath>Defs/SitePartDef[defName="VQE_Quest1Site"]/gravShipsCanLandOn</xpath>
                        <nomatch Class="PatchOperationAdd">
                            <xpath>Defs/SitePartDef[defName="VQE_Quest1Site" or defName="VQE_Quest2Site" or defName="VQE_Quest3Site" or defName="VQE_Quest4Site" or defName="VQE_Quest5Site" or defName="VQE_Quest5Site_Geothermal" or defName="VQE_Quest5Site_Nuclear"]</xpath>
                            <value>
                                <gravShipsCanLandOn>true</gravShipsCanLandOn>
                            </value>
                        </nomatch>
                    </li>
                </operations>
            </match>
        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Quests Expanded - Cryptoforge</li>
        </mods>
        <match Class="PatchOperationFindMod">
            <mods>
                <li>Odyssey</li>
            </mods>
            <match Class="PatchOperationSequence">
                <operations>
                    <li Class="PatchOperationConditional">
                        <xpath>Defs/SitePartDef[defName="VQE_CryptoforgeChapter1Site"]/gravShipsCanLandOn</xpath>
                        <nomatch Class="PatchOperationAdd">
                            <xpath>Defs/SitePartDef[defName="VQE_CryptoforgeChapter1Site"]</xpath>
                            <value>
                                <gravShipsCanLandOn>true</gravShipsCanLandOn>
                            </value>
                        </nomatch>
                    </li>
                </operations>
            </match>
        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Factions Expanded - Insectoids 2</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationConditional">
                    <xpath>Defs/SitePartDef[defName="VFEI_InsectoidHiveRatingOne"]/gravShipsCanLandOn</xpath>
                    <nomatch Class="PatchOperationAdd">
                        <xpath>Defs/SitePartDef[defName="VFEI_InsectoidHiveRatingOne" or defName="VFEI_InsectoidHiveRatingTwo" or defName="VFEI_InsectoidHiveRatingThree"]</xpath>
                        <value>
                            <gravShipsCanLandOn>true</gravShipsCanLandOn>
                        </value>
                    </nomatch>
                </li>
            </operations>
        </match>
    </Operation>

</Patch>