<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Bodyparts -->
	<!-- bionic -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/HediffDef[defName="ArchotechEye"]</xpath>
		<value>
			<stages Operation="Safe">
				<li Operation="Safe">
					<statOffsets Operation="Safe">
						<PawnBeauty Operation="SafeAdd">1</PawnBeauty>
					</statOffsets>
				</li>
			</stages>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>ludeon.rimworld.biotech</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- detoxifier -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="DetoxifierLung"]</xpath>
				<value>
					<addedPartProps Operation="Safe">
						<partEfficiency Operation="SafeReplace">1.25</partEfficiency>
					</addedPartProps>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="DetoxifierKidney"]</xpath>
				<value>
					<addedPartProps Operation="Safe">
						<partEfficiency Operation="SafeReplace">1.25</partEfficiency>
					</addedPartProps>
				</value>
			</Operation>
			<!-- mechanitor -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="ControlSublinkHigh"]</xpath>
				<value>
					<costList Operation="SafeReplace">
						<ComponentSpacer>4</ComponentSpacer>
						<PowerfocusChip>1</PowerfocusChip>
					</costList>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>ludeon.rimworld.anomaly</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- prosthetics -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="GhoulPlating"]/stages/li</xpath>
				<value>
					<capMods Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText" XPathLocal="capacity">
							<capacity>Moving</capacity>
							<offset>-0.1</offset>
						</li>
					</capMods>
					<statOffsets Operation="Safe">
						<MoveSpeed Operation="SafeRemove">0</MoveSpeed>
					</statOffsets>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="GhoulBarbs"]/stages/li</xpath>
				<value>
					<capMods Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText" XPathLocal="capacity">
							<capacity>Moving</capacity>
							<offset>-0.1</offset>
						</li>
					</capMods>
					<statFactors Operation="Safe">
						<MeleeDamageFactor Operation="SafeRemove">0</MeleeDamageFactor>
					</statFactors>
					<statOffsets Operation="Safe">
						<MeleeDamageFactor Operation="SafeAdd">0.5</MeleeDamageFactor>
						<MoveSpeed Operation="SafeRemove">0</MoveSpeed>
					</statOffsets>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="AdrenalHeart"]/stages/li</xpath>
				<value>
					<hungerRateFactor Operation="SafeAdd">1.2</hungerRateFactor>
					<hungerRateFactorOffset Operation="SafeRemove"/>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="MetalbloodHeart"]/stages/li</xpath>
				<value>
					<capMods Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText" XPathLocal="capacity">
							<capacity>Moving</capacity>
							<offset>-0.05</offset>
						</li>
					</capMods>
					<statOffsets Operation="Safe">
						<MoveSpeed Operation="SafeRemove">0</MoveSpeed>
					</statOffsets>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>ludeon.rimworld.odyssey</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- prosthetics -->
			<Operation Class="XmlExtensions.SetScope">
				<xpath>Defs/HediffDef[defName="BloodWarmer"]</xpath>
				<apply>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef</xpath>
						<value>
							<addedPartProps Operation="Safe">
								<partEfficiency Operation="SafeRemove">0</partEfficiency>
							</addedPartProps>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li</xpath>
						<value>
							<statOffsets Operation="Safe">
								<ComfyTemperatureMin Operation="SafeReplace">-20</ComfyTemperatureMin>
							</statOffsets>
						</value>
					</Operation>
				</apply>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="PilotAssistant"]/stages/li</xpath>
				<value>
					<statOffsets Operation="Safe">
						<PilotingAbility Operation="SafeReplace">0.5</PilotingAbility>
					</statOffsets>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.SetScope">
				<xpath>Defs/HediffDef[defName="VacskinGland"]</xpath>
				<apply>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li</xpath>
						<value>
							<capMods Operation="Safe">
								<li Operation="Safe" Compare="InnerText" XPathLocal="capacity">
									<capacity Operation="Safe">Moving</capacity>
									<offset Operation="SafeAdd">-0.1</offset>
									<postFactor Operation="SafeRemove">0</postFactor>
								</li>
							</capMods>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.FindMod">
						<mods>
							<li>v1024.ebframework</li>
						</mods>
						<packageId>true</packageId>
						<caseTrue>
							<Operation Class="XmlExtensions.HybridPatch">
								<xpath>HediffDef</xpath>
								<value>
									<comps Operation="Safe">
										<li Class="EBF.Hediffs.HediffCompProperties_MaxHPAdjust" Operation="Safe" CheckAttributes="True">
											<scaleAdjustment Operation="AddOrReplace">0.25</scaleAdjustment>
										</li>
									</comps>
								</value>
							</Operation>
						</caseTrue>
					</Operation>
				</apply>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- [FSF] Vanilla Bionics Expansion -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>frozensnowfox.vanillabionicsexpansion</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- archotech -->
			<Operation Class="XmlExtensions.SetScope">
				<xpath>Defs/HediffDef[defName="FSFArchotechStomach"]</xpath>
				<apply>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li</xpath>
						<value>
							<hungerRateFactor Operation="SafeReplace">0.2</hungerRateFactor>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.FindMod">
						<mods>
							<li>ebsg.framework</li>
						</mods>
						<packageId>true</packageId>
						<caseTrue>
							<Operation Class="XmlExtensions.HybridPatch">
								<xpath>HediffDef/stages/li</xpath>
								<value>
									<hungerRateFactor Operation="SafeRemove"/>
									<statFactors Operation="Safe">
										<EBSG_HungerRateFactor Operation="SafeAdd">0.2</EBSG_HungerRateFactor>
									</statFactors>
								</value>
							</Operation>
						</caseTrue>
					</Operation>
				</apply>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Medical System Expansion 2 -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>mse2.core</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/HediffDef[@ParentName="AddedBodyPart_Limb_Archotech" or @ParentName="AddedBodyPart_Limb_Bionic"]/comps/li[@Class="MSE2.HediffCompProperties_ModuleHolder" and maxModules="1"]</xpath>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeReplace">
				<xpath>Defs/HediffDef[@ParentName="AddedBodyPart_Limb_Archotech" or @ParentName="AddedBodyPart_Limb_Bionic"]/comps/li[@Class="MSE2.HediffCompProperties_ModuleHolder" and maxModules="2"]</xpath>
				<value>
					<maxModules>1</maxModules>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.SetScope">
				<xpath>Defs/HediffDef[@Name="AddedBodyPart_Limb_Archotech"]</xpath>
				<apply>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef</xpath>
						<value>
							<defaultLabelColor Operation="AddOrReplace">(139, 143, 104)</defaultLabelColor>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.FindMod">
						<mods>
							<li>v1024.ebframework</li>
						</mods>
						<packageId>true</packageId>
						<caseTrue>
							<Operation Class="XmlExtensions.HybridPatch">
								<xpath>HediffDef</xpath>
								<value>
									<comps Operation="Safe">
										<li Class="EBF.Hediffs.HediffCompProperties_MaxHPAdjust" Operation="Safe" CheckAttributes="True">
											<scaleAdjustment Operation="AddOrReplace">0.5</scaleAdjustment>
										</li>
									</comps>
								</value>
							</Operation>
						</caseTrue>
					</Operation>
				</apply>
			</Operation>
			<Operation Class="XmlExtensions.SetScope">
				<xpath>Defs/HediffDef[@Name="AddedBodyPart_Limb_Bionic"]</xpath>
				<apply>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef</xpath>
						<value>
							<defaultLabelColor Operation="AddOrReplace">(0.6, 0.6, 1.0)</defaultLabelColor>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.FindMod">
						<mods>
							<li>v1024.ebframework</li>
						</mods>
						<packageId>true</packageId>
						<caseTrue>
							<Operation Class="XmlExtensions.HybridPatch">
								<xpath>HediffDef</xpath>
								<value>
									<comps Operation="Safe">
										<li Class="EBF.Hediffs.HediffCompProperties_MaxHPAdjust" Operation="Safe" CheckAttributes="True">
											<scaleAdjustment Operation="AddOrReplace">0.25</scaleAdjustment>
										</li>
									</comps>
								</value>
							</Operation>
						</caseTrue>
					</Operation>
				</apply>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/HediffDef[@ParentName="AddedBodyPart_Limb_Archotech"]/comps/li[@Class="EBF.Hediffs.HediffCompProperties_MaxHPAdjust"]</xpath>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/HediffDef[@ParentName="AddedBodyPart_Limb_Bionic"]/comps/li[@Class="EBF.Hediffs.HediffCompProperties_MaxHPAdjust"]</xpath>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="BionicInternalSupport"]</xpath>
				<value>
					<addedPartProps Operation="Safe">
						<partEfficiency Operation="SafeReplace">1.15</partEfficiency>
					</addedPartProps>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[@ParentName="AddedBodyPart_Limb_Bionic"]
					[defName="BionicArm"]</xpath>
				<value>
					<addedPartProps Operation="Safe">
						<partEfficiency Operation="SafeReplace">1.25</partEfficiency>
					</addedPartProps>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[@ParentName="AddedBodyPart_Limb_Bionic"]
					[defName="BionicForearm" or 
					defName="BionicHand"]</xpath>
				<value>
					<addedPartProps Operation="Safe">
						<partEfficiency Operation="SafeReplace">1.2</partEfficiency>
					</addedPartProps>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[@ParentName="AddedBodyPart_Limb_Bionic"]
					[defName="BionicFinger"]</xpath>
				<value>
					<addedPartProps Operation="Safe">
						<partEfficiency Operation="SafeReplace">1.15</partEfficiency>
					</addedPartProps>
				</value>
			</Operation>
			<!--Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[@ParentName="AddedBodyPart_Limb_Bionic"]
					[defName="BionicLeg" or 
					defName="BionicFoot" or 
					defName="BionicToe"]</xpath>
				<value>
					<addedPartProps Operation="Safe">
						<partEfficiency Operation="SafeReplace">1.25</partEfficiency>
					</addedPartProps>
				</value>
			</Operation-->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="ArchotechInternalSupport"]</xpath>
				<value>
					<addedPartProps Operation="Safe">
						<partEfficiency Operation="SafeReplace">1.3</partEfficiency>
					</addedPartProps>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[@ParentName="AddedBodyPart_Limb_Archotech"]
					[defName="ArchotechArm" or 
					defName="ArchotechForearm" or 
					defName="ArchotechHand" or 
					defName="ArchotechToe"]</xpath>
				<value>
					<addedPartProps Operation="Safe">
						<partEfficiency Operation="SafeReplace">1.4</partEfficiency>
					</addedPartProps>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[@ParentName="AddedBodyPart_Limb_Archotech"][defName="ArchotechFinger"]</xpath>
				<value>
					<addedPartProps Operation="Safe">
						<partEfficiency Operation="SafeReplace">1.3</partEfficiency>
					</addedPartProps>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>v1024.ebframework</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<!--Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/HediffDef[defName="FSFBionicDrillArm" or 
							defName="FSFBionicFieldArm"]</xpath>
						<value>
							<addedPartProps Operation="Safe">
								<partEfficiency Operation="SafeReplace">1.2</partEfficiency>
							</addedPartProps>
						</value>
					</Operation-->
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/HediffDef[defName="BionicDrillForearm" or 
							defName="BionicManipulator" or 
							defName="BionicFieldForearm" or 
							defName="BionicFieldHand"]</xpath>
						<value>
							<addedPartProps Operation="Safe">
								<partEfficiency Operation="SafeReplace">1.2</partEfficiency>
							</addedPartProps>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/HediffDef[defName="BionicManipulatorFinger" or 
							defName="BionicFieldFinger"]</xpath>
						<value>
							<addedPartProps Operation="Safe">
								<partEfficiency Operation="SafeReplace">1.15</partEfficiency>
							</addedPartProps>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

	<!--Vanilla Races Expanded - Android -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>vanillaracesexpanded.android</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- reactor -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="VREA_Reactor"]</xpath>
				<value>
					<costList Operation="SafeReplace">
						<ComponentSpacer>2</ComponentSpacer>
						<Plasteel>25</Plasteel>
						<Uranium>25</Uranium>
					</costList>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
