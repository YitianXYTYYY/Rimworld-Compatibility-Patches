<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>Ludeon.RimWorld.Royalty</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="MeleeWeapon_PsyfocusStaff"]</xpath>
				<value>
					<equippedStatOffsets Operation="Safe">
						<PsychicSensitivityOffset Operation="SafeReplace">0.8</PsychicSensitivityOffset>
					</equippedStatOffsets>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Vanilla Weapons Expanded -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>vanillaexpanded.vwe</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="VWE_MeleeWeapon_Shovel"]/recipeMaker</xpath>
				<value>
					<researchPrerequisite Operation="SafeRemove"/>
					<researchPrerequisites Inherit="False" Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">Machining</li>
						<li Operation="SafeAdd" Compare="InnerText">Smithing</li>
					</researchPrerequisites>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="VWE_MeleeWeapon_Baton"]/recipeMaker</xpath>
				<value>
					<researchPrerequisite Operation="SafeRemove"/>
					<researchPrerequisites Inherit="False" Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">Machining</li>
						<li Operation="SafeAdd" Compare="InnerText">Smithing</li>
					</researchPrerequisites>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="VWE_MeleeWeapon_CombatKnife"]/recipeMaker</xpath>
				<value>
					<researchPrerequisite Operation="SafeRemove"/>
					<researchPrerequisites Inherit="False" Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">Machining</li>
						<li Operation="SafeAdd" Compare="InnerText">Smithing</li>
					</researchPrerequisites>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/ThingDef/recipeMaker[researchPrerequisite="VWE_TrenchWarfare"]</xpath>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/ResearchProjectDef[defName="VWE_TrenchWarfare"]</xpath>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
