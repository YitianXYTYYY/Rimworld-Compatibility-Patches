<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Vanilla Factions Expanded - Empire -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>oskarpotocki.vfe.empire</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/AbilityDef[defName="VFEE_RoyalAddress"]/meats</xpath>
				<value>
					<showWhenDrafted Operation="SafeAdd">false</showWhenDrafted>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
