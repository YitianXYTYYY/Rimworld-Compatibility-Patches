						<value>ArmorHelmetMakeableBase</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>ThingDef</xpath>
						<value>
							<equippedStatOffsets Operation="Safe">
								<ShootingAccuracyPawn Operation="SafeReplace">-2</ShootingAccuracyPawn>
							</equippedStatOffsets>
							<recipeMaker Operation="Safe">
								<skillRequirements Operation="Safe">
									<Crafting Operation="SafeReplace">7</Crafting>
								</skillRequirements>
								<unfinishedThingDef Operation="SafeAdd">UnfinishedMetallicTechArmor</unfinishedThingDef>
							</recipeMaker>
							<thingSetMakerTags Operation="Safe">
								<li Operation="SafeAdd" Compare="InnerText">RewardStandardQualitySuper</li>
							</thingSetMakerTags>
							<tradeTags Operation="Safe">
								<li Operation="SafeAdd" Compare="InnerText">Clothing</li>
