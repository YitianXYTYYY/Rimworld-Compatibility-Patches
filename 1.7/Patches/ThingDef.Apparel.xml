	<!-- Vanilla Prestige Specialist Armours Reworked -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>prestigespecialistarmours.final</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="Apparel_ArmorLocustPrestige"]</xpath>
				<value>
    				<label Operation="SafeReplace">recon prestige armor - locust</label>
					<costList Operation="SafeReplace">
						<ComponentSpacer>6</ComponentSpacer>
						<Plasteel>125</Plasteel>
						<Chemfuel>100</Chemfuel>
						<Gold>10</Gold>
					</costList>
					<equippedStatOffsets Operation="Safe">
						<PsychicSensitivity Operation="SafeRemove">0</PsychicSensitivity>
						<PsychicSensitivityOffset Operation="SafeAdd">0.1</PsychicSensitivityOffset>
					</equippedStatOffsets>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.SetScope">
				<xpath>Defs/ThingDef[defName="Apparel_ArmorGrenadierPrestige"]</xpath>
				<apply>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>ThingDef</xpath>
						<value>
							<label Operation="SafeReplace">marine prestige armor - grenadier</label>
							<costList Operation="SafeReplace">
								<ComponentSpacer>7</ComponentSpacer>
								<Plasteel>150</Plasteel>
								<Steel>75</Steel>
								<Gold>10</Gold>
							</costList>
							<equippedStatOffsets Operation="Safe">
								<PsychicSensitivity Operation="SafeRemove">0</PsychicSensitivity>
								<PsychicSensitivityOffset Operation="SafeAdd">0.1</PsychicSensitivityOffset>
							</equippedStatOffsets>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.FindMod">
						<mods>
							<li>mlie.yayoscombat3</li>
						</mods>
						<packageId>true</packageId>
						<caseTrue>
							<Operation Class="XmlExtensions.HybridPatch">
								<xpath>ThingDef</xpath>
								<value>
									<costList Operation="Safe">
										<Steel Operation="SafeRemove">0</Steel>
										<WeaponGrenadeFrag Operation="SafeAdd">2</WeaponGrenadeFrag>
									</costList>
									<comps Operation="Safe">
										<li Class="CompProperties_ApparelReloadable" Operation="Safe" CheckAttributes="True">
											<ammoDef Operation="SafeReplace">WeaponGrenadeFrag</ammoDef>
											<ammoCountPerCharge Operation="SafeReplace">1</ammoCountPerCharge>
										</li>
									</comps>
								</value>
							</Operation>
						</caseTrue>
					</Operation>
				</apply>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="Apparel_ArmorPhoenixPrestige"]</xpath>
				<value>
    				<label Operation="SafeReplace">cataphract prestige armor - phoenix</label>
