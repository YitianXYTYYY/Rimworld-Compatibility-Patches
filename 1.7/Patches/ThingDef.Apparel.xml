<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Packs Are Not Belts -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>turnovus.submod.backpacksarenotbelts</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/ApparelLayerDef[defName="PacksAreNotBelts_Exoskeleton"]/modExtensions/li[@Class="HeavyWeaponsAcceptAllUtilities.DefExtension_IsUtilityLayer"]</xpath>
			</Operation>
		</caseTrue>
	</Operation>

