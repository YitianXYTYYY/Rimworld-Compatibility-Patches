<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>ludeon.rimworld.biotech</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- ReSplice: Core -->
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>resplice.xotr.core</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneCategoryDef[defName="RS_DarkArchite"]</xpath>
						<value>
							<displayPriorityInXenotype Operation="AddOrReplace">1100</displayPriorityInXenotype>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
			<!--Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/GeneCategoryDef[defName="Archite"]</xpath>
				<value>
					<displayPriorityInXenotype Operation="AddOrReplace">1000</displayPriorityInXenotype>
				</value>
			</Operation-->
			<!-- Vanilla Quests Expanded - Ancients -->
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaquestsexpanded.ancients</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneCategoryDef[defName="VQEA_ArchiteAptitudes"]</xpath>
						<value>
							<displayPriorityInXenotype Operation="AddOrReplace">990</displayPriorityInXenotype>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
			<!-- Vanilla Races Expanded - Insector -->
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaracesexpanded.insector</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneCategoryDef[defName="VRE_EvolutionGene"]</xpath>
						<value>
							<displayPriorityInXenotype Operation="AddOrReplace">920</displayPriorityInXenotype>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneCategoryDef[defName="VRE_MutationGene"]</xpath>
						<value>
							<displayPriorityInXenotype Operation="AddOrReplace">910</displayPriorityInXenotype>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/GeneCategoryDef[defName="VRE_InsectorCosmeticGene"]</xpath>
						<value>
