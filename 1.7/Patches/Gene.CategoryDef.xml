						<value>
							<displayPriorityInXenotype Operation="AddOrReplace">510</displayPriorityInXenotype>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>Turnovus.Biotech.IntegratedGenes</li>
