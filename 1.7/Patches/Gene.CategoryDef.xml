	</Operation>

	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>lucius.eyegenes3</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/GeneCategoryDef[defName="EyeGenes3_Eyes"]</xpath>
				<value>
					<displayPriorityInGenepack Operation="SafeRemove"/>
					<displayPriorityInXenotype Operation="AddOrReplace">-1010</displayPriorityInXenotype>
					<label Operation="SafeReplace">cosmetic - eye color</label>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
