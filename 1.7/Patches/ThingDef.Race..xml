<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Anomaly -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>ludeon.rimworld.anomaly</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="Sightstealer"]</xpath>
				<value>
					<race Operation="Safe">
						<baseHealthScale Operation="SafeReplace">1.5</baseHealthScale>
					</race>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="Gorehulk"]</xpath>
				<value>
					<race Operation="Safe">
						<baseHealthScale Operation="SafeReplace">2</baseHealthScale>
					</race>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="Chimera"]</xpath>
				<value>
					<race Operation="Safe">
						<baseHealthScale Operation="SafeReplace">4.5</baseHealthScale>
					</race>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="Noctol"]</xpath>
				<value>
					<race Operation="Safe">
						<baseHealthScale Operation="SafeReplace">3</baseHealthScale>
					</race>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="Devourer"]</xpath>
				<value>
					<race Operation="Safe">
						<baseHealthScale Operation="SafeReplace">9</baseHealthScale>
					</race>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="Revenant"]</xpath>
				<value>
					<race Operation="Safe">
						<baseHealthScale Operation="SafeReplace">15</baseHealthScale>
					</race>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="Metalhorror"]</xpath>
				<value>
					<statBases Operation="Safe">
						<ArmorRating_Sharp Operation="SafeReplace">1</ArmorRating_Sharp>
						<ArmorRating_Blunt Operation="SafeReplace">1</ArmorRating_Blunt>
					</statBases>
					<tools Operation="Safe">
						<li Operation="Safe" Compare="InnerText" XPathLocalName="label">
							<label Operation="Safe">left blade</label>
							<armorPenetration Operation="SafeAdd">1</armorPenetration>
						</li>
						<li Operation="Safe" Compare="InnerText" XPathLocalName="label">
							<label Operation="Safe">right blade</label>
							<armorPenetration Operation="SafeAdd">1</armorPenetration>
						</li>
					</tools>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="Bulbfreak"]</xpath>
				<value>
					<race Operation="Safe">
						<baseHealthScale Operation="SafeReplace">1</baseHealthScale>
					</race>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="Dreadmeld"]</xpath>
				<value>
					<race Operation="Safe">
						<baseHealthScale Operation="SafeReplace">20</baseHealthScale>
					</race>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

