<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="XmlExtensions.SetScope" MayRequire="ferny.replacelib">
		<xpath>Defs/ReplaceLib.ReplacerDef[defName="ReplaceLib_XYTYYY"]</xpath>
		<apply>
			<!-- Glass Roofs -->
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>wailor.glassroofs</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="PatchOperationAdd">
						<xpath>ReplaceLib.ReplacerDef/replacers</xpath>
						<value>
							<li MayRequire="rebuild.cotr.doorsandcorners">
								<replace>RB_Glass</replace>
								<with>GR_Glass</with>
							</li>
						</value>
					</Operation>
				</caseTrue>
				<caseFalse>
					<Operation Class="PatchOperationAdd">
						<xpath>ReplaceLib.ReplacerDef/replacers</xpath>
						<value>
							<li MayRequire="rebuild.cotr.doorsandcorners">
								<replace>GR_Glass</replace>
								<with>RB_Glass</with>
							</li>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
			<!-- Vanilla Chemfuel Expanded -->
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaexpanded.vchemfuele</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="PatchOperationAdd">
						<xpath>ReplaceLib.ReplacerDef/replacers</xpath>
						<value>
							<li MayRequire="vanillaexpanded.vgeneticse">
								<replace>GR_CompressedChemfuel</replace>
								<with>VCHE_Deepchem</with>
							</li>
						</value>
					</Operation>
				</caseTrue>
				<caseFalse>
					<Operation Class="PatchOperationAdd">
						<xpath>ReplaceLib.ReplacerDef/replacers</xpath>
						<value>
							<li MayRequire="vanillaexpanded.vgeneticse">
								<replace>VCHE_Deepchem</replace>
								<with>GR_CompressedChemfuel</with>
							</li>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
			<!-- Vanilla Factions Expanded - Insectoids 2 -->
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>oskarpotocki.vfe.insectoid2</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="PatchOperationAdd">
						<xpath>ReplaceLib.ReplacerDef/replacers</xpath>
						<value>
							<li MayRequire="com.abobashark.zoologymod">
								<replace>Leather_Chitin</replace>
								<with>VFEI2_Chitin</with>
							</li>
						</value>
					</Operation>
				</caseTrue>
				<caseFalse>
					<Operation Class="PatchOperationAdd">
						<xpath>ReplaceLib.ReplacerDef/replacers</xpath>
						<value>
							<li MayRequire="com.abobashark.zoologymod">
								<replace>VFEI2_Chitin</replace>
								<with>Leather_Chitin</with>
							</li>
						</value>
					</Operation>
				</caseFalse>
			</Operation>
			<!-- Yayo's Combat 3 (Continued) -->
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>mlie.yayoscombat3</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="PatchOperationAdd">
						<xpath>ReplaceLib.ReplacerDef/replacers</xpath>
						<value>
							<li>
								<replace>Weapon_GrenadeMolotov</replace>
								<with>WeaponGrenadeMolotov</with>
							</li>
							<li>
								<replace>Weapon_GrenadeFrag</replace>
								<with>WeaponGrenadeFrag</with>
							</li>
							<li>
								<replace>Weapon_GrenadeEMP</replace>
								<with>WeaponGrenadeEMP</with>
							</li>
							<li MayRequire="ludeon.rimworld.biotech">
								<replace>Weapon_GrenadeTox</replace>
								<with>WeaponGrenadeTox</with>
							</li>
							<li MayRequire="vanillaexpanded.vwe">
								<replace>VWE_SmokeGrenade</replace>
								<with>VWESmokeGrenade</with>
							</li>
							<li MayRequire="vanillaexpanded.vwe">
								<replace>VWE_FlashGrenade</replace>
								<with>VWEFlashGrenade</with>
							</li>
						</value>
					</Operation>
					<Operation Class="PatchOperationAdd">
						<xpath>ReplaceLib.ReplacerDef/replacers</xpath>
						<value>
							<li>
								<replace>yy_ammo_primitive_fire</replace>
								<with>yy_ammo_primitive</with>
							</li>
							<li>
								<replace>yy_ammo_primitive_emp</replace>
								<with>yy_ammo_primitive</with>
							</li>
							<li>
								<replace>yy_ammo_industrial_fire</replace>
								<with>yy_ammo_industrial</with>
							</li>
							<li>
								<replace>yy_ammo_industrial_emp</replace>
								<with>yy_ammo_industrial</with>
							</li>
							<li>
								<replace>yy_ammo_spacer_fire</replace>
								<with>yy_ammo_spacer</with>
							</li>
							<li>
								<replace>yy_ammo_spacer_emp</replace>
								<with>yy_ammo_spacer</with>
							</li>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.FindMod">
						<mods>
							<li>syrus.yayoscombataddon</li>
						</mods>
						<packageId>true</packageId>
						<caseTrue>
							<Operation Class="PatchOperationAdd">
								<xpath>ReplaceLib.ReplacerDef/replacers</xpath>
								<value>
									<li>
										<replace>yy_ammo_primitive_light</replace>
										<with>yy_ammo_primitive</with>
									</li>
									<li>
										<replace>yy_ammo_primitive_heavy</replace>
										<with>yy_ammo_primitive</with>
									</li>
									<li>
										<replace>yy_ammo_industrial_light</replace>
										<with>yy_ammo_industrial</with>
									</li>
									<li>
										<replace>yy_ammo_industrial_heavy</replace>
										<with>yy_ammo_industrial</with>
									</li>
									<li>
										<replace>yy_ammo_spacer_light</replace>
										<with>yy_ammo_spacer</with>
									</li>
									<li>
										<replace>yy_ammo_spacer_heavy</replace>
										<with>yy_ammo_spacer</with>
									</li>
								</value>
							</Operation>
						</caseTrue>
					</Operation>
				</caseTrue>
			</Operation>
		</apply>
	</Operation>

</Patch>