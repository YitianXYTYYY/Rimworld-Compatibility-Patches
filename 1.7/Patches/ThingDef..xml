<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Davai's Sorted Categories -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>davai.sortedcategories</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.OptionalPatchExternal">
				<ModClass>DavaiSortedCategories.Mod</ModClass>
				<field>CreateComponentsCategory</field>
				<caseTrue>
					<!-- ARC component -->
					<Operation Class="XmlExtensions.FindMod">
						<mods>
							<li>vanillaquestsexpanded.generator</li>
						</mods>
						<packageId>true</packageId>
						<caseTrue>
							<Operation Class="XmlExtensions.HybridPatch">
								<xpath>Defs/ThingDef[defName="VQE_GenetronComponent"]</xpath>
								<value>
									<thingCategories Operation="Safe">
										<li Operation="SafeRemove" Compare="InnerText">Manufactured</li>
										<li Operation="SafeAdd" Compare="InnerText">DavaiComponents</li>
									</thingCategories>
								</value>
							</Operation>
						</caseTrue>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Glass Roofs -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>wailor.glassroofs</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>rebuild.cotr.doorsandcorners</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.PatchOperationSafeRemove">
						<xpath>Defs/ThingDef[defName="GR_Glass"][@ParentName!="RB_Glass"]</xpath>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Medical System Expansion 2 -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>mse2.core</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- modules -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingCategoryDef[defName="MSE2Modules"]</xpath>
				<value>
					<parent Operation="SafeReplace">BodyParts</parent>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- ReBuild: Doors and Corners -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>rebuild.cotr.doorsandcorners</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- Glass -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[@Name="RB_GlassBase"]</xpath>
				<value>
					<thingCategories Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">Manufactured</li>
						<li Operation="SafeAdd" Compare="InnerText">RBGlasses</li>
					</thingCategories>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationAttributeSet">
				<xpath>Defs/ThingDef[defName="RB_Glass"]</xpath>
				<attribute>Name</attribute>
				<value>RB_Glass</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="RB_BallisticGlass"]</xpath>
				<value>
					<label Operation="SafeReplace">reinforced glass</label>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Vanilla Genetics Expanded -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>vanillaexpanded.vgeneticse</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingCategoryDef[defName="GR_ImplantCategory"]</xpath>
				<value>
					<label Operation="SafeReplace">hybrid animal implants</label>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[@Name="GR_HumanImplantBase"]</xpath>
				<value>
					<thingCategories Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">GR_ImplantCategory</li>
						<li Operation="SafeAdd" Compare="InnerText">GRImplantHuman</li>
					</thingCategories>
				</value>
			</Operation>
			<!-- Items Resource GenomeExcavators -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="GR_ArchotechGenomeExcavator"]</xpath>
				<value>
					<techLevel Operation="SafeAdd">Archotech</techLevel>
				</value>
			</Operation>
			<!-- Items Resource GrowthCells -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="GR_ArchoGrowthcell"]</xpath>
				<value>
					<techLevel Operation="SafeAdd">Archotech</techLevel>
				</value>
			</Operation>
			<!-- Items Resource HybridAnimalProducts - Other -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThingDef[defName="GR_HugeBearPelt" or 
					defName="GR_HugeBearCatPelt" or 
					defName="GR_MuffaloPelt" or 
					defName="GR_WolfPelt"]</xpath>
				<value>
					<thingCategories Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">ResourcesRaw</li>
						<li Operation="SafeAdd" Compare="InnerText">GRPelts</li>
					</thingCategories>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
