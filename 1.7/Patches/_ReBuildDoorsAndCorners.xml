<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>ReBuild: Doors and Corners</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationFindMod">
					<mods>
						<li>Vanilla Furniture Expanded</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationReplace">
								<xpath>Defs/ThingDef[defName="Light_Streetlamp"]/costList</xpath>
								<value>
									<costList>
										<Steel>35</Steel>
										<RB_Glass>5</RB_Glass>
									</costList>
								</value>
							</li>
						</operations>
					</match>
				</li>
				<li Class="PatchOperationFindMod">
					<mods>
						<li>Vanilla Furniture Expanded - Spacer Module</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationReplace">
								<xpath>Defs/ThingDef[defName="Spacer_OutdoorLamp"]/costList</xpath>
								<value>
									<costList>
										<Steel>25</Steel>
										<RB_Glass>5</RB_Glass>
										<ComponentIndustrial>1</ComponentIndustrial>
									</costList>
								</value>
							</li>
						</operations>
					</match>
				</li>
				<li Class="PatchOperationFindMod">
					<mods>
						<li>Vanilla Factions Expanded - Settlers</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationReplace">
								<xpath>Defs/ThingDef[defName="Chemlamp"]/costList</xpath>
								<value>
									<costList>
										<Steel>15</Steel>
										<RB_Glass>5</RB_Glass>
										<Chemfuel>10</Chemfuel>
									</costList>
								</value>
							</li>
							<li Class="PatchOperationReplace">
								<xpath>Defs/ThingDef[defName="ChemlampPost"]/costList</xpath>
								<value>
									<costList>
										<RB_Glass>5</RB_Glass>
										<Chemfuel>10</Chemfuel>
									</costList>
								</value>
							</li>
							<li Class="PatchOperationReplace">
								<xpath>Defs/ThingDef[defName="ChemlampPost"]/costStuffCount</xpath>
								<value>
									<costStuffCount>15</costStuffCount>
								</value>
							</li>
						</operations>
					</match>
				</li>
				<li Class="PatchOperationFindMod">
					<mods>
						<li>Biomes! Fossils</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationReplace">
								<xpath>Defs/ThingDef[defName="BMT_DisplayLight"]/costList</xpath>
								<value>
									<costList>
										<Steel>6</Steel>
										<RB_Glass>2</RB_Glass>
									</costList>
								</value>
							</li>
						</operations>
					</match>
				</li>
			</operations>
		</match>
	</Operation>

</Patch>