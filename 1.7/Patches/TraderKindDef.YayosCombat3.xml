<?xml version="1.0" encoding="utf-8"?>
<Patch>	

	<!-- Yayo's Combat 3 (Continued) -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>mlie.yayoscombat3</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- Ammo Trade -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/TraderKindDef[not(orbital="true")]/stockGenerators[li[tradeTag="WeaponRanged" and maxTechLevelGenerate="Neolithic"]]</xpath>
				<value>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>AmmoPrimitive</thingDef>
						<countRange>15~150</countRange>
					</li>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>Pila</thingDef>
						<countRange>5~25</countRange>
					</li>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/TraderKindDef[not(orbital="true")]/stockGenerators[li[tradeTag="WeaponRanged" and not(maxTechLevelGenerate="Neolithic" or weaponTag="SpacerGun")]]</xpath>
				<value>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>AmmoIndustrial</thingDef>
						<countRange>75~300</countRange>
					</li>
					<li Class="StockGenerator_Tag" Operation="Add">
						<tradeTag>Ammo</tradeTag>
						<thingDefCountRange>-1~2</thingDefCountRange>
						<countRange>25~225</countRange>
						<excludedThingDefs>
							<li>AmmoPrimitive</li>
							<li>AmmoIndustrial</li>
						</excludedThingDefs>
					</li>
					<li Class="StockGenerator_Tag" Operation="Add">
						<tradeTag>Grenades</tradeTag>
						<thingDefCountRange>0~3</thingDefCountRange>
						<countRange>3~15</countRange>
					</li>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/TraderKindDef[not(orbital="true")]/stockGenerators[li[tradeTag="WeaponRanged" and weaponTag="SpacerGun"]]</xpath>
				<value>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>AmmoIndustrial</thingDef>
						<countRange>75~300</countRange>
					</li>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>AmmoSpacer</thingDef>
						<countRange>25~225</countRange>
					</li>
					<li Class="StockGenerator_Tag" Operation="Add">
						<tradeTag>Ammo</tradeTag>
						<thingDefCountRange>-1~2</thingDefCountRange>
						<countRange>25~225</countRange>
						<excludedThingDefs>
							<li>AmmoPrimitive</li>
							<li>AmmoIndustrial</li>
							<li>AmmoSpacer</li>
						</excludedThingDefs>
					</li>
					<li Class="StockGenerator_Tag" Operation="Add">
						<tradeTag>Grenades</tradeTag>
						<thingDefCountRange>0~3</thingDefCountRange>
						<countRange>3~15</countRange>
					</li>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/TraderKindDef[not(orbital="true")]/stockGenerators[li/tradeTag="MortarShell"]</xpath>
				<value>
					<li Class="StockGenerator_Tag" Operation="Add">
						<tradeTag>Grenades</tradeTag>
						<thingDefCountRange>1~3</thingDefCountRange>
						<countRange>3~15</countRange>
					</li>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/TraderKindDef[orbital="true"]/stockGenerators[li[tradeTag="WeaponRanged"]]</xpath>
				<value>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>AmmoIndustrial</thingDef>
						<countRange>150~450</countRange>
					</li>
					<li Class="StockGenerator_SingleDef" MayRequire="reel.turretpipeline" Operation="Add">
						<thingDef>ReelTurretAmmo</thingDef>
						<countRange>75~300</countRange>
					</li>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>AmmoSpacer</thingDef>
						<countRange>75~300</countRange>
					</li>
					<li Class="StockGenerator_SingleDef" Operation="Add">
						<thingDef>AmmoSpacerEMP</thingDef>
						<countRange>75~225</countRange>
					</li>
					<li Class="StockGenerator_Tag" Operation="Add">
						<tradeTag>Ammo</tradeTag>
						<thingDefCountRange>-1~3</thingDefCountRange>
						<countRange>25~225</countRange>
						<excludedThingDefs>
							<li>AmmoPrimitive</li>
							<li>AmmoSpacerEMP</li>
						</excludedThingDefs>
					</li>
					<li Class="StockGenerator_Tag" Operation="Add">
						<tradeTag>Grenades</tradeTag>
						<thingDefCountRange>1~3</thingDefCountRange>
						<countRange>20~40</countRange>
					</li>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>teiwaz.gtgot</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/TraderKindDef[defName="Orbital_GTGMilitaryCorporation"]/stockGenerators</xpath>
						<value>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_GlobalSingleDef" Operation="Add">
								<thingDef>AmmoIndustrial</thingDef>
								<countRange>750~2250</countRange>
							</li>
							<li Class="StockGenerator_SingleDef" MayRequire="reel.turretpipeline" Operation="Add">
								<thingDef>ReelTurretAmmo</thingDef>
								<countRange>450~1350</countRange>
							</li>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_GlobalSingleDef" Operation="Add">
								<thingDef>AmmoSpacer</thingDef>
								<countRange>600~1800</countRange>
							</li>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_GlobalSingleDef" Operation="Add">
								<thingDef>AmmoSpacerEMP</thingDef>
								<countRange>450~1350</countRange>
							</li>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_Tag" Operation="Add">
								<tradeTag>Ammo</tradeTag>
								<thingDefCountRange>2~8</thingDefCountRange>
								<countRange>150~450</countRange>
								<excludedThingDefs>
									<li>AmmoPrimitive</li>
								</excludedThingDefs>
							</li>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_Tag" Operation="Add">
								<tradeTag>Grenades</tradeTag>
								<thingDefCountRange>3~6</thingDefCountRange>
								<countRange>25~100</countRange>
							</li>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/TraderKindDef[defName="Orbital_GTGBlackMarket"]/stockGenerators</xpath>
						<value>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_GlobalSingleDef" Operation="Add">
								<thingDef>AmmoIndustrial</thingDef>
								<countRange>300~900</countRange>
							</li>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_GlobalSingleDef" Operation="Add">
								<thingDef>AmmoSpacer</thingDef>
								<countRange>300~600</countRange>
							</li>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_Tag" Operation="Add">
								<tradeTag>Ammo</tradeTag>
								<thingDefCountRange>1~6</thingDefCountRange>
								<countRange>75~300</countRange>
								<excludedThingDefs>
									<li>AmmoPrimitive</li>
								</excludedThingDefs>
							</li>
							<li Class="GTGTraderCore.GTGTC_StockGenerator_Tag" Operation="Add">
								<tradeTag>Grenades</tradeTag>
								<thingDefCountRange>1~6</thingDefCountRange>
								<countRange>25~50</countRange>
							</li>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
