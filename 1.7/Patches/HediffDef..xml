<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Big and Small - Framework -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>redmattis.betterprerequisites</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="BS_CryogenicInhibition"]/stages/li[label="extreme"]</xpath>
				<value>
					<hungerRateFactor Operation="SafeAdd">0.2</hungerRateFactor>
					<hungerRateFactorOffset Operation="SafeRemove"/>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanya.tools.bulkcarrier</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<!-- race trackers -->
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/HediffDef[defName="BS_CentaurRace"]/stages/li</xpath>
						<value>
							<statFactors Operation="Safe">
								<VEF_MassCarryCapacity Operation="SafeRemove">3</VEF_MassCarryCapacity>
							</statFactors>
							<statOffsets Operation="Safe">
								<CarryingCapacity Operation="SafeAdd">150</CarryingCapacity>
							</statOffsets>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/HediffDef[defName="BS_SpiderPersonRace"]/stages/li</xpath>
						<value>
							<statFactors Operation="Safe">
								<VEF_MassCarryCapacity Operation="SafeRemove">1.5</VEF_MassCarryCapacity>
							</statFactors>
							<statOffsets Operation="Safe">
								<CarryingCapacity Operation="SafeAdd">40</CarryingCapacity>
							</statOffsets>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

	<!--Contagion -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>cheatereater.contagion</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="Contagion_Animal_GutWorms"]/stages/li</xpath>
				<value>
					<hungerRateFactor Operation="SafeAdd">2</hungerRateFactor>
					<hungerRateFactorOffset Operation="SafeRemove"/>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

	<!--Vanilla Genetics Expanded -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>vanillaexpanded.vgeneticse</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- Hybird HungerByQuality -->
			<Operation Class="XmlExtensions.SetScope">
				<xpath>Defs/HediffDef[defName="GR_HungerByQuality"]</xpath>
				<apply>
					<Operation Class="XmlExtensions.PatchOperationSafeRemove">
						<xpath>HediffDef/stages/li/hungerRateFactorOffset</xpath>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li[minSeverity="0"]</xpath>
						<value>
							<hungerRateFactor Operation="SafeAdd">2</hungerRateFactor>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li[minSeverity="0.1"]</xpath>
						<value>
							<hungerRateFactor Operation="SafeAdd">1.5</hungerRateFactor>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li[minSeverity="0.3"]</xpath>
						<value>
							<hungerRateFactor Operation="SafeAdd">0.8</hungerRateFactor>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li[minSeverity="0.4"]</xpath>
						<value>
							<hungerRateFactor Operation="SafeAdd">0.5</hungerRateFactor>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li[minSeverity="0.5"]</xpath>
						<value>
							<hungerRateFactor Operation="SafeAdd">0.2</hungerRateFactor>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li[minSeverity="0.6"]</xpath>
						<value>
							<hungerRateFactor Operation="SafeAdd">0.05</hungerRateFactor>
						</value>
					</Operation>
				</apply>
			</Operation>
			<!-- lifespan diseases -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="GR_GreaterScaria"]/stages/li</xpath>
				<value>
					<hungerRateFactor Operation="SafeAdd">0</hungerRateFactor>
					<hungerRateFactorOffset Operation="SafeRemove"/>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Vanilla Races Expanded - Highmate -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>vanillaracesexpanded.highmate</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="VRE_PsychicBondBloodlust"]</xpath>
				<value>
					<label Operation="SafeReplace">psychic bond (combative)</label>
					<stages Operation="Safe">
						<li Operation="Safe">
							<statFactors Operation="Safe">
								<MeleeDamageFactor Operation="SafeRemove">0</MeleeDamageFactor>
							</statFactors>
							<statOffsets Operation="Safe">								
								<MeleeHitChance Operation="SafeAdd">4</MeleeHitChance>
							</statOffsets>
						</li>
					</stages>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="VRE_PsychicBondFastLearner"]</xpath>
				<value>
					<label Operation="SafeReplace">psychic bond (quick-learner)</label>
					<stages Operation="Safe">
						<li Operation="Safe">
							<statOffsets Operation="Safe">								
								<GlobalLearningFactor Operation="SafeReplace">0.2</GlobalLearningFactor>
							</statOffsets>
						</li>
					</stages>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="VRE_PsychicBondIndustrious"]</xpath>
				<value>
					<label Operation="SafeReplace">psychic bond (diligent)</label>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="VRE_PsychicBondSanguine"]</xpath>
				<value>
					<label Operation="SafeReplace">psychic bond (optimist)</label>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ThoughtDef[defName="VRE_PsychicBondSanguine"]/stages/li</xpath>
				<value>
					<label Operation="SafeReplace">psychic bond (optimist)</label>
					<baseMoodEffect Operation="SafeReplace">5</baseMoodEffect>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="VRE_PsychicBondIronWilled"]</xpath>
				<value>
					<label Operation="SafeReplace">psychic bond (steadfast)</label>
					<stages Operation="Safe">
						<li Operation="Safe">
							<statOffsets Operation="Safe">								
								<MentalBreakThreshold Operation="SafeReplace">-0.1</MentalBreakThreshold>
							</statOffsets>
						</li>
					</stages>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="VRE_PsychicBondCarefulShooter"]</xpath>
				<value>
					<label Operation="SafeReplace">psychic bond (precise)</label>
					<stages Operation="Safe">
						<li Operation="Safe">
							<statOffsets Operation="Safe">								
								<ShootingAccuracyPawn Operation="SafeReplace">4</ShootingAccuracyPawn>
							</statOffsets>
						</li>
					</stages>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="VRE_PsychicBondPsychicallyHypersensitive"]</xpath>
				<value>
					<label Operation="SafeReplace">psychic bond (psy-sensitive)</label>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="VRE_PsychicBondGreatMemory"]</xpath>
				<value>
					<label Operation="SafeReplace">psychic bond (wise)</label>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="VRE_PsychicBondAbrasive"]</xpath>
				<value>
					<label Operation="SafeReplace">psychic bond (abrasive)</label>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>danzinagri.mmmm.integrations.other</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/HediffDef[defName="TMM_PsychicBondRest"]</xpath>
						<value>
							<label Operation="SafeReplace">psychic bond (vitalized)</label>
							<stages Operation="Safe">
								<li Operation="Safe">
									<statFactors Operation="Safe">
										<RestRateMultiplier Operation="SafeRemove">0</RestRateMultiplier>
									</statFactors>
									<statOffsets Operation="Safe">
										<RestRateMultiplier Operation="SafeAdd">0.2</RestRateMultiplier>
									</statOffsets>
								</li>
							</stages>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Vanilla Races Expanded - Insector -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>vanillaracesexpanded.insector</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<!-- hediffs reproduction -->
			<Operation Class="XmlExtensions.SetScope">
				<xpath>Defs/HediffDef[defName="VRE_ChestburstPregnancy_Victim"]</xpath>
				<apply>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li[label="egg"]</xpath>
						<value>
							<hungerRateFactor Operation="SafeReplace">1.2</hungerRateFactor>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li[label="larva"]</xpath>
						<value>
							<hungerRateFactor Operation="SafeReplace">1.5</hungerRateFactor>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li[label="pupa"]</xpath>
						<value>
							<hungerRateFactor Operation="SafeReplace">2</hungerRateFactor>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li[label="juvenile"]</xpath>
						<value>
							<hungerRateFactor Operation="SafeReplace">2</hungerRateFactor>
						</value>
					</Operation>
				</apply>
			</Operation>
			<Operation Class="XmlExtensions.SetScope">
				<xpath>Defs/HediffDef[defName="VRE_ChestburstPregnancy_Victim_Hidden"]</xpath>
				<apply>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li[label="egg"]</xpath>
						<value>
							<hungerRateFactor Operation="SafeReplace">1.2</hungerRateFactor>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li[label="larva"]</xpath>
						<value>
							<hungerRateFactor Operation="SafeReplace">1.5</hungerRateFactor>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li[label="pupa"]</xpath>
						<value>
							<hungerRateFactor Operation="SafeReplace">2</hungerRateFactor>
						</value>
					</Operation>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef/stages/li[label="juvenile"]</xpath>
						<value>
							<hungerRateFactor Operation="SafeReplace">2</hungerRateFactor>
						</value>
					</Operation>
				</apply>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Vanilla Races Expanded - Sanguophage -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>vanillaracesexpanded.sanguophage</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="VRE_ConsumedAnimalHemogen"]/stages/li</xpath>
				<value>
					<statFactors Operation="Safe">
						<MeleeCooldownFactor Operation="SafeAdd">0.8</MeleeCooldownFactor>
						<MeleeDPS Operation="SafeRemove">0</MeleeDPS>
					</statFactors>
					<statOffsets Operation="Safe">
						<InjuryHealingFactor Operation="SafeReplace">1</InjuryHealingFactor>
					</statOffsets>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="VRE_ConsumedSanguophageHemogen"]/stages/li</xpath>
				<value>
					<painOffset Operation="SafeRemove"/>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

	<!-- Waster's Breath -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>wasterbreath.mod</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/HediffDef[defName="ToxApparelWasterStimulusMask" or 
					defName="ToxApparelWasterStimulusHelmet"]</xpath>
				<value>
					<comps Operation="Safe">
						<li Class="HediffCompProperties_RemoveIfApparelDropped" Operation="SafeRemove" CheckAttributes="True">0</li>
					</comps>
				</value>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
