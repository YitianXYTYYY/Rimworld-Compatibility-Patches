<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ResearchProjectDef[defName="GravBiotech"]</xpath>
		<value>
			<requiredResearchFacilities Operation="Safe">
				<li Operation="SafeAdd" Compare="InnerText">MultiAnalyzer</li>
			</requiredResearchFacilities>
			<tab Operation="AddOrReplace">TechGravship</tab>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ResearchProjectDef[defName="GravDeathrest"]</xpath>
		<value>
			<prerequisites Operation="Safe">
				<li Operation="SafeRemove" Compare="InnerText">Deathrest</li>
			</prerequisites>
			<hiddenPrerequisites Operation="Safe">
				<li Operation="SafeAdd" Compare="InnerText">Deathrest</li>
			</hiddenPrerequisites>
			<requiredResearchFacilities Operation="Safe">
				<li Operation="SafeAdd" Compare="InnerText">MultiAnalyzer</li>
			</requiredResearchFacilities>
			<tab Operation="AddOrReplace">TechGravship</tab>
		</value>
	</Operation>

</Patch>
