<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- aperitif -->
	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/ThingDef[defName="VFEE_Aperitif"]</xpath>
		<apply>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>ThingDef</xpath>
				<value>
					<ingestible Operation="Safe">
						<drugCategory Operation="SafeReplace">Social</drugCategory>
					</ingestible>
				</value>
			</Operation>
		</apply>
	</Operation>
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/HediffDef[defName="VFEE_IngestedAperitif"]/stages/li</xpath>
		<value>
			<hungerRateFactor Operation="SafeAdd">2</hungerRateFactor>
			<hungerRateFactorOffset Operation="SafeRemove"/>
		</value>
	</Operation>

</Patch>
