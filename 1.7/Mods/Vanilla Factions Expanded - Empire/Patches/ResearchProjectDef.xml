<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/ResearchProjectDef[defName="VFEE_JanissaryGear"]</xpath>
		<apply>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaexpanded.varme</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>ResearchProjectDef</xpath>
						<value>
							<prerequisites Operation="Safe">
								<li Operation="SafeRemove" Compare="InnerText">ReconArmor</li>
								<li Operation="SafeAdd" Compare="InnerText">VAE_TrooperArmor</li>
							</prerequisites>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</apply>
	</Operation>

</Patch>
