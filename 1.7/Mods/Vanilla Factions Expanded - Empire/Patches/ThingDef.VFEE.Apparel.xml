<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- absolver -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="VFEE_Apparel_AbsolverHelmet"]</xpath>
		<value>
			<costList Operation="SafeAdd">
				<ComponentSpacer>2</ComponentSpacer>
				<Plasteel>100</Plasteel>
				<Gold>15</Gold>
			</costList>
			<equippedStatOffsets Operation="Safe">
				<ShootingAccuracyPawn Operation="SafeReplace">8</ShootingAccuracyPawn>
			</equippedStatOffsets>
		</value>
	</Operation>
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="VFEE_Apparel_ArmorAbsolver"]</xpath>
		<value>
			<apparel Operation="Safe">
				<layers Operation="Safe">
					<li Operation="SafeRemove" Compare="InnerText">OnSkin</li>
					<!--li Operation="SafeAdd" Compare="InnerText">Shell</li-->
				</layers>
			</apparel>
			<costList Operation="SafeAdd">
				<ComponentSpacer>8</ComponentSpacer>
				<Plasteel>150</Plasteel>
				<Uranium>75</Uranium>
				<Gold>25</Gold>
			</costList>
			<equippedStatOffsets Operation="Safe">
				<MoveSpeed Operation="SafeAdd">0.6</MoveSpeed>
			</equippedStatOffsets>
			<modExtensions Operation="Safe">
				<li Class="VEF.Apparels.ApparelExtension" Operation="Safe" CheckAttributes="True">
					<equippedStatFactors Operation="Safe">
						<MoveSpeed Operation="SafeRemove">0</MoveSpeed>
					</equippedStatFactors>
				</li>
			</modExtensions>
		</value>
	</Operation>

	<!-- deserter -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="VFEE_Apparel_DeserterHelmet"]</xpath>
		<value>
			<costList Operation="SafeAdd">
				<ComponentSpacer>2</ComponentSpacer>
				<Plasteel>100</Plasteel>
				<Gold>20</Gold>
			</costList>
			<equippedStatOffsets Operation="Safe">
				<ShootingAccuracyPawn Operation="SafeReplace">4</ShootingAccuracyPawn>
			</equippedStatOffsets>
		</value>
	</Operation>
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="VFEE_Apparel_ArmorDeserter"]</xpath>
		<value>
			<costList Operation="SafeAdd">
				<ComponentSpacer>6</ComponentSpacer>
				<Plasteel>150</Plasteel>
				<Uranium>75</Uranium>
				<Gold>40</Gold>
			</costList>
			<equippedStatOffsets Operation="Safe">
				<PsychicSensitivity Operation="SafeRemove">0</PsychicSensitivity>
				<PsychicSensitivityOffset Operation="SafeAdd">0.2</PsychicSensitivityOffset>
			</equippedStatOffsets>
		</value>
	</Operation>

	<!-- janissary -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="VFEE_Apparel_JanissaryHelmet"]</xpath>
		<value>
			<costList Operation="SafeReplace">
				<ComponentSpacer>2</ComponentSpacer>
				<Plasteel>50</Plasteel>
			</costList>
			<equippedStatOffsets Operation="Safe">
				<ToxicResistance Operation="SafeRemove">0</ToxicResistance>
			</equippedStatOffsets>
		</value>
	</Operation>
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="VFEE_Apparel_JanissaryCuirass"]</xpath>
		<value>
			<costList Operation="SafeAdd">
				<ComponentSpacer>3</ComponentSpacer>
				<Plasteel>50</Plasteel>
				<Uranium>25</Uranium>
			</costList>
		</value>
	</Operation>

</Patch>
