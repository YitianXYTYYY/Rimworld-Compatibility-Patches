<?xml version="1.0" encoding="utf-8"?>
<Patch>


	<Operation Class="XmlExtensions.PatchOperationSafeRemove">
		<xpath>Defs/ThingDef[defName="Apparel_ToxClothMask"][@ParentName!="Apparel_ClothMask"]</xpath>
	</Operation>

	<Operation Class="XmlExtensions.PatchOperationSafeRemove">
		<xpath>Defs/ThingDef[defName="Apparel_ToxArmorHelmetRecon"][@ParentName!="Apparel_ArmorHelmetRecon"]</xpath>
	</Operation>

	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>ludeon.rimworld.royalty</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/ThingDef[defName="Apparel_ToxArmorHelmetCataphract"][@ParentName!="Apparel_ArmorHelmetCataphract"]</xpath>
			</Operation>
		</caseTrue>
	</Operation>

	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>ludeon.rimworld.biotech</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/ThingDef[defName="Apparel_ToxArmorHelmetMechlord"][@ParentName!="Apparel_ArmorHelmetMechlordHelmet"]</xpath>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>ferny.progressionrobotics2</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/ThingDef[defName="Apparel_ToxArmorHelmetMechlord"]</xpath>
						<value>
							<recipeMaker Operation="Safe">
								<researchPrerequisites Operation="Safe">
									<li Operation="SafeRemove" Compare="InnerText">UltraMechtech</li>
									<li Operation="SafeAdd" Compare="InnerText">Ferny_MechlordSuit</li>
								</researchPrerequisites>
							</recipeMaker>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>ludeon.rimworld.odyssey</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/ThingDef[defName="Apparel_ToxVacsuitHelmet"][@ParentName!="Apparel_VacsuitHelmet"]</xpath>
			</Operation>
		</caseTrue>
	</Operation>

	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>vanillaexpanded.varme</li>
		</mods>
		<packageId>true</packageId>
		<caseTrue>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/ThingDef[defName="Apparel_ToxVAE_TrooperHelmet"][@ParentName!="VAE_Headgear_TrooperHelmet"]</xpath>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>Defs/ThingDef[defName="Apparel_ToxVAE_SiegebreakerHelmet"][@ParentName!="VAE_Headgear_HeavyMarineHelmet"]</xpath>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>