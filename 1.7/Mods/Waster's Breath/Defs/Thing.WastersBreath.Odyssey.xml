<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="Apparel_VacsuitHelmet" MayRequire="ludeon.rimworld.odyssey">
		<defName>Apparel_VacsuitHelmetTox</defName>
		<label>vacsuit helmet - tox</label>
		<description>A helmet that efficiently recycles the user's oxygen, allowing them to breathe in the vacuum of space for hours at a time. The process isn't perfectly efficient, so the user must periodically return to a pressurized environment.\n\nA special filter delivers toxins to stimulate toxic genes.</description>
		<descriptionHyperlinks>
		<HediffDef>ToxicBuildup</HediffDef>
		</descriptionHyperlinks>
		<comps>
			<li Class="Tox.CompProperties_ToxFilterCharge">
				<fuelDef>Chemfuel</fuelDef>
				<fuelAmount>20</fuelAmount>
				<chargeDays>5</chargeDays>
				<hediff>ToxApparelPoisoningHelmet</hediff>
				<wasterHediff>ToxApparelWasterStimulusHelmet</wasterHediff>
				<part>Head</part>
			</li>
		</comps>
		<costList>
			<Chemfuel>20</Chemfuel>
		</costList>
		<recipeMaker>
			<researchPrerequisite Inherit="False"/>
			<researchPrerequisites Inherit="False">
				<li>OrbitalTech</li>
				<li>ToxFilterArmor</li>
			</researchPrerequisites>
			<displayPriority>238</displayPriority>
		</recipeMaker>
		<tickerType>Normal</tickerType>
	</ThingDef>

</Defs>