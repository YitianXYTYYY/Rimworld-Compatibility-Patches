<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="VFEE_Apparel_JanissaryHelmet" MayRequire="oskarpotocki.vfe.empire">
		<defName>VFEE_Apparel_JanissaryHelmetTox</defName>
		<label>janissary helmet - tox</label>
		<description>A high-tech armored helmet with a built-in status computer and a protective plasteel-weave plate.\n\nIncludes a plasteel-plated gas mask that offers full protection against gas-related attacks, such as toxic environments.\n\nA special filter delivers toxins to stimulate toxic genes.</description>
		<descriptionHyperlinks>
			<HediffDef>ToxicBuildup</HediffDef>
		</descriptionHyperlinks>
		<comps>
			<li Class="Tox.CompProperties_ToxFilterCharge">
				<fuelDef>Chemfuel</fuelDef>
				<fuelAmount>20</fuelAmount>
				<chargeDays>5</chargeDays>
				<hediff>ToxApparelPoisoningHelmet</hediff>
				<wasterHediff>ToxApparelWasterStimulusHelmet</wasterHediff>
				<part>Head</part>
			</li>
		</comps>
		<costList>
			<Chemfuel>20</Chemfuel>
		</costList>
		<recipeMaker>
			<researchPrerequisite Inherit="False"/>
			<researchPrerequisites Inherit="False">
				<li>ToxFilterArmor</li>
				<li>VFEE_JanissaryGear</li>
			</researchPrerequisites>
		</recipeMaker>
		<tickerType>Normal</tickerType>
	</ThingDef>

</Defs>