<Defs>

	<ThingDef ParentName="VAE_Headgear_TrooperHelmet" MayRequire="vanillaexpanded.varme">
		<defName>VAE_Headgear_TrooperHelmetTox</defName>
		<label>trooper helmet - tox</label>
		<description>A high-tech and lightweight armored helmet with a protective plasteel-weave plate.\n\nArmor like this is often used by imperial conscripts and late-midworld military forces.\n\nA special filter delivers toxins to stimulate toxic genes.</description>
		<descriptionHyperlinks>
			<HediffDef>ToxicBuildup</HediffDef>
		</descriptionHyperlinks>
		<comps>
			<li Class="Tox.CompProperties_ToxFilterCharge">
				<fuelDef>Chemfuel</fuelDef>
				<fuelAmount>20</fuelAmount>
				<chargeDays>5</chargeDays>
				<hediff>ToxApparelPoisoningHelmet</hediff>
				<wasterHediff>ToxApparelWasterStimulusHelmet</wasterHediff>
				<part>Head</part>
			</li>
		</comps>
		<costList>
			<Chemfuel>20</Chemfuel>
		</costList>
		<recipeMaker>
			<researchPrerequisite Inherit="False"/>
			<researchPrerequisites Inherit="False">
				<li>ToxFilterArmor</li>
				<li>VAE_TrooperArmor</li>
			</researchPrerequisites>
			<displayPriority>112</displayPriority>
		</recipeMaker>
		<tickerType>Normal</tickerType>
	</ThingDef>

