<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Pherocore -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[@Name="VFEI2_PherocoreBase"]</xpath>
		<value>
			<thingCategories Operation="Safe">
				<li Operation="SafeRemove" Compare="InnerText">ItemsMisc</li>
				<li Operation="SafeAdd" Compare="InnerText">VFEI2Pherocores</li>
			</thingCategories>
		</value>
	</Operation>
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[@ParentName="VFEI2_PherocoreBase"][defName="VFEI2_PherocoreSorne"]</xpath>
		<value>
			<statBases Operation="Safe">
				<MarketValue Operation="SafeReplace">1500</MarketValue>
			</statBases>
		</value>
	</Operation>
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[@ParentName="VFEI2_PherocoreBase"][defName!="VFEI2_PherocoreSorne"]</xpath>
		<value>
			<statBases Operation="Safe">
				<MarketValue Operation="SafeReplace">2500</MarketValue>
			</statBases>
		</value>
	</Operation>

</Patch>