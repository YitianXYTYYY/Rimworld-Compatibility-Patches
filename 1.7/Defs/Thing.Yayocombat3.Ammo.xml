	<ThingDef ParentName="UnfinishedBase" MayRequire="mlie.yayoscombat3">
		<defName>AmmoPrimitive_Unfinish</defName>
		<label>unfinished arrow</label>
		<description>An unfinished arrow.</description>
		<statBases>
			<Flammability>1</Flammability>
		</statBases>
		<graphicData>
			<texPath>Things/Item/Unfinished/UnfinishedWeapon</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<color>(133,97,67)</color>
		</graphicData>
		<stuffCategories Inherit="false"/>
	</ThingDef>
	<ThingDef ParentName="UnfinishedBase" MayRequire="mlie.yayoscombat3">
