<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Primitive -->
	<ThingDef ParentName="ResourceBase" MayRequire="mlie.yayoscombat3">
		<defName>AmmoPrimitive</defName>
		<label>arrow</label>
		<description>Ammunition used in bow weapons.</description>
		<graphicData>
			<texPath>yy_ammo_primitive</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<healthAffectsPrice>false</healthAffectsPrice>
		<soundInteract>Wood_Drop</soundInteract>
		<soundDrop>Wood_Drop</soundDrop>
		<stackLimit>75</stackLimit>
		<statBases>
			<MarketValue>1.5</MarketValue>
			<MaxHitPoints>20</MaxHitPoints>
			<Mass>0.04</Mass>
			<Flammability>1</Flammability>
			<DeteriorationRate>1.0</DeteriorationRate>
		</statBases>
    	<techLevel>Neolithic</techLevel>
		<thingCategories>
			<li>yy_ammo_category</li>
		</thingCategories>
		<tradeTags>
			<li>Ammo</li>
		</tradeTags>
	</ThingDef>
	<RecipeDef MayRequire="mlie.yayoscombat3">
		<defName>Make_AmmoPrimitive</defName>
		<label>make arrow</label>
		<description>Ammunition used in bow weapons.</description>
		<jobString>Making arrow.</jobString>
		<workAmount>300</workAmount>
		<workSkill>Crafting</workSkill>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<effectWorking>Smith</effectWorking>
		<soundWorking>Recipe_MakeBow</soundWorking>
		<researchPrerequisite MayRequire="oskarpotocki.vfe.tribals">VFET_Bow</researchPrerequisite>
		<recipeUsers>
			<li>CraftingSpot</li>
		</recipeUsers>
		<allowMixingIngredients>true</allowMixingIngredients>
		<skillRequirements>
			<Crafting>1</Crafting>
		</skillRequirements>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>WoodLog</li>
					</thingDefs>
				</filter>
				<count>15</count>
			</li>
		</ingredients>
		<products>
			<AmmoPrimitive>15</AmmoPrimitive>
		</products>
		<unfinishedThingDef>AmmoPrimitive_Unfinish</unfinishedThingDef>
	</RecipeDef>

	<!-- Industrial -->
	<ThingDef ParentName="ResourceBase" MayRequire="mlie.yayoscombat3">
		<defName>AmmoIndustrial</defName>
		<label>ammo</label>
		<description>Ammunition used for most industrial era ranged weapons.</description>
		<graphicData>
			<texPath>yy_ammo_industrial</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<healthAffectsPrice>false</healthAffectsPrice>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<stackLimit>150</stackLimit>
		<statBases>
			<MarketValue>3.5</MarketValue>
			<MaxHitPoints>20</MaxHitPoints>
			<Mass>0.02</Mass>
			<Flammability>0.6</Flammability>
			<DeteriorationRate>1.0</DeteriorationRate>
		</statBases>
    	<techLevel>Industrial</techLevel>
		<thingCategories>
			<li>yy_ammo_category</li>
		</thingCategories>
		<tradeTags>
			<li>Ammo</li>
		</tradeTags>
	</ThingDef>
	<RecipeDef MayRequire="mlie.yayoscombat3">
		<defName>Make_AmmoIndustrial</defName>
		<label>make ammo</label>
		<description>Ammunition used for most industrial era ranged weapons.</description>
		<jobString>Making ammo.</jobString>
		<workAmount>600</workAmount>
		<workSkill>Crafting</workSkill>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<effectWorking>Smith</effectWorking>
		<soundWorking>Recipe_Machining</soundWorking>
		<researchPrerequisite>Gunsmithing</researchPrerequisite>
		<recipeUsers>
			<li>TableMachining</li>
		</recipeUsers>
		<skillRequirements>
			<Crafting>6</Crafting>
		</skillRequirements>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Uranium</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>25</count>
			</li>
		</ingredients>
		<products>
			<AmmoIndustrial>25</AmmoIndustrial>
		</products>
		<unfinishedThingDef>AmmoIndustrial_Unfinish</unfinishedThingDef>
	</RecipeDef>

