<Patch>

	<!-- Apparel Belts -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Apparel_PackBroadshield"]</xpath>
		<value>
			<costList Operation="Safe">
				<ComponentIndustrial Operation="SafeRemove">0</ComponentIndustrial>
				<ComponentSpacer Operation="SafeAdd">1</ComponentSpacer>
			</costList>
			<recipeMaker Operation="Safe">
				<recipeUsers Operation="Safe">
					<li Operation="SafeAdd" Compare="InnerText">FabricationBench</li>
					<li Operation="SafeRemove" Compare="InnerText">TableMachining</li>
				</recipeUsers>
			</recipeMaker>
		</value>
	</Operation>

	<!-- Apparel Psychic -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Apparel_PsyfocusHelmet"]</xpath>
		<value>
			<costList Operation="Safe">
				<Gold Operation="SafeAdd">5</Gold>
			</costList>
			<costStuffCount Operation="SafeAdd">50</costStuffCount>
			<equippedStatOffsets Operation="Safe">
				<PsychicSensitivityOffset Operation="SafeReplace">0.2</PsychicSensitivityOffset>
			</equippedStatOffsets>
			<recipeMaker Operation="Safe">
				<recipeUsers Operation="Safe">
					<li Operation="SafeAdd" Compare="InnerText">ElectricSmithy</li>
					<li Operation="SafeAdd" Compare="InnerText">FueledSmithy</li>
					<li MayRequire="vanillaexpanded.helixiengas" Operation="SafeAdd" Compare="InnerText">VHGE_GasPoweredSmithy</li>
				</recipeUsers>
				<researchPrerequisites Inherit="False" Operation="Safe">
					<li Operation="SafeAdd" Compare="InnerText">EltexApparel</li>
				</researchPrerequisites>
				<effectWorking Operation="SafeAdd">Smith</effectWorking>
				<soundWorking Operation="SafeAdd">Recipe_Smith</soundWorking>
				<unfinishedThingDef Operation="SafeAdd">UnfinishedMetallicTechArmor</unfinishedThingDef>
				<workSkill Operation="SafeAdd">Crafting</workSkill>
				<workSpeedStat Operation="SafeAdd">GeneralLaborSpeed</workSpeedStat>
				<skillRequirements Operation="Safe">
					<Crafting Operation="SafeAdd">8</Crafting>
				</skillRequirements>
			</recipeMaker>
			<statBases Operation="Safe">
				<ArmorRating_Blunt Operation="SafeRemove">0</ArmorRating_Blunt>
				<ArmorRating_Heat Operation="SafeRemove">0</ArmorRating_Heat>
				<ArmorRating_Sharp Operation="SafeRemove">0</ArmorRating_Sharp>
				<Insulation_Cold Operation="SafeRemove">0</Insulation_Cold>
				<Insulation_Heat Operation="SafeRemove">0</Insulation_Heat>
				<MarketValue Operation="SafeRemove">0</MarketValue>
				<StuffEffectMultiplierArmor Operation="SafeAdd">0.5</StuffEffectMultiplierArmor>
				<StuffEffectMultiplierInsulation_Cold Operation="SafeAdd">0.40</StuffEffectMultiplierInsulation_Cold>
				<StuffEffectMultiplierInsulation_Heat Operation="SafeAdd">0.10</StuffEffectMultiplierInsulation_Heat>
				<WorkToMake Operation="SafeAdd">18000</WorkToMake>
			</statBases>
			<stuffCategories Operation="Safe">
				<li Operation="SafeAdd" Compare="InnerText">Metallic</li>
			</stuffCategories>
		</value>
	</Operation>

