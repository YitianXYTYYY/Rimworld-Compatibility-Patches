<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ResearchProjectDef[defName="Harp"]</xpath>
		<value>
			<prerequisites Operation="Safe">
				<li Operation="SafeRemove" Compare="InnerText">ComplexFurniture</li>
				<li Operation="SafeAdd" Compare="InnerText">Smithing</li>
			</prerequisites>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ResearchProjectDef[defName="Harpsichord"]</xpath>
		<value>
			<prerequisites Operation="Safe">
				<li Operation="SafeRemove" Compare="InnerText">Smithing</li>
			</prerequisites>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ResearchProjectDef[defName="JumpPack"]</xpath>
		<value>
			<prerequisites Operation="Safe">
				<li Operation="SafeRemove" Compare="InnerText">MicroelectronicsBasics</li>
				<li Operation="SafeAdd" Compare="InnerText">Machining</li>
			</prerequisites>
			<hiddenPrerequisites Operation="Safe">
				<li Operation="SafeRemove" Compare="InnerText">Machining</li>
			</hiddenPrerequisites>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ResearchProjectDef[@ParentName="BaseBodyPartEmpire_TierB"]</xpath>
		<value>
			<prerequisites Operation="Safe">
				<li Operation="SafeAdd" Compare="InnerText">Bionics</li>
				<li Operation="SafeRemove" Compare="InnerText">Fabrication</li>
			</prerequisites>
			<hiddenPrerequisites Operation="Safe">
				<li Operation="SafeRemove" Compare="InnerText">Prosthetics</li>
			</hiddenPrerequisites>
		</value>
	</Operation>
	
	<!-- Medical System Expansion 2 -->
	<Operation Class="XmlExtensions.FindMod">
		<mods>
			<li>mse2.core</li>
		</mods>
		<packageId>true</packageId>
		<caseFalse>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ResearchProjectDef[@ParentName="BaseBodyPartEmpire_TierA"]</xpath>
				<value>
					<prerequisites Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">MicroelectronicsBasics</li>
						<li Operation="SafeAdd" Compare="InnerText">Prosthetics</li>
					</prerequisites>
					<hiddenPrerequisites Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">Prosthetics</li>
					</hiddenPrerequisites>
					<requiredResearchFacilities Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">MultiAnalyzer</li>
					</requiredResearchFacilities>
					<!--tab Operation="AddOrReplace">TechProsthetics</tab-->
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ResearchProjectDef[@Name="BaseBodyPartEmpire_TierB"]</xpath>
				<value>
					<prerequisites Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">Prosthetics</li>
					</prerequisites>
					<!--tab Operation="AddOrReplace">TechProsthetics</tab-->
				</value>
			</Operation>
		</caseFalse>
		<caseTrue>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ResearchProjectDef[@ParentName="BaseBodyPartEmpire_TierA"]</xpath>
				<value>
					<prerequisites Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">MicroelectronicsBasics</li>
						<li Operation="SafeAdd" Compare="InnerText">BoneProstheticsPlasteel</li>
					</prerequisites>
					<hiddenPrerequisites Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">Prosthetics</li>
					</hiddenPrerequisites>
					<requiredResearchFacilities Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">MultiAnalyzer</li>
					</requiredResearchFacilities>
					<!--tab Operation="AddOrReplace">TechProsthetics</tab-->
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>Defs/ResearchProjectDef[@Name="BaseBodyPartEmpire_TierB"]</xpath>
				<value>
					<prerequisites Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">BoneProstheticsPlasteel</li>
					</prerequisites>
					<!--tab Operation="AddOrReplace">TechProsthetics</tab-->
				</value>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
