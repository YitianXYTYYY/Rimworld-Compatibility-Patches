	<!-- Machining -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ResearchProjectDef[defName="Machining"]</xpath>
		<value>
			<prerequisites Operation="Safe">
				<li Operation="SafeRemove" Compare="InnerText">Smithing</li>
			</prerequisites>
			<hiddenPrerequisites Operation="Safe">
				<li Operation="SafeAdd" Compare="InnerText">Smithing</li>
			</hiddenPrerequisites>
		</value>
	</Operation>
	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/ResearchProjectDef[defName="Prosthetics"]</xpath>
		<apply>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>ResearchProjectDef</xpath>
				<value>
					<requiredResearchBuilding Operation="SafeAdd">HiTechResearchBench</requiredResearchBuilding>
					<!--tab Operation="AddOrReplace">TechProsthetics</tab-->
				</value>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>mse2.core</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>ResearchProjectDef</xpath>
						<value>
							<prerequisites Operation="Safe">
								<li Operation="SafeAdd" Compare="InnerText">BoneProstheticsSimple</li>
								<li Operation="SafeRemove" Compare="InnerText">Machining</li>
							</prerequisites>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</apply>
	</Operation>
