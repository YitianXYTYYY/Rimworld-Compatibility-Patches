		<xpath>Defs/ThingDef[researchPrerequisites/li="FoamTurret"]</xpath>
		<value>
			<researchPrerequisites Inherit="False" Operation="Safe">
				<li Operation="SafeAdd" Compare="InnerText">Firefoam</li>
				<li Operation="SafeRemove" Compare="InnerText">FoamTurret</li>
				<li Operation="SafeAdd" Compare="InnerText">GunTurrets</li>
			</researchPrerequisites>
		</value>
