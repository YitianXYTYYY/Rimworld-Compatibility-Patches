<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- artifacts -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="PsychicSoothePulser"]</xpath>
		<value>
			<tradeNeverStack Operation="SafeRemove"/>
		</value>
	</Operation>
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="PsychicAnimalPulser"]</xpath>
		<value>
			<tradeNeverStack Operation="SafeRemove"/>
		</value>
	</Operation>

	<!-- resource manufactured -->
	<!-- reinforced barrel -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="ReinforcedBarrel"]</xpath>
		<value>
			<thingCategories Operation="Safe">
				<li Operation="SafeRemove" Compare="InnerText">ItemsMisc</li>
				<li Operation="SafeAdd" Compare="InnerText">Manufactured</li>
			</thingCategories>
		</value>
	</Operation>

</Patch>
