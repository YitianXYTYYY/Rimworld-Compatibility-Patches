<?xml version="1.0" encoding="utf-8"?>
<Patch>	

	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/ThinkTreeDef[defName="Humanlike"]</xpath>
		<apply>
			<!-- Prevent Packing Food -->
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>ThinkTreeDef/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalColonist"]/subNodes/li[@Class="ThinkNode_ConditionalNeedPercentageAbove"][need="Food"]</xpath>
				<value>
					<threshold Operation="SafeReplace">1</threshold>
				</value>
			</Operation>
		</apply>
	</Operation>

</Patch>
