<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Apparel Belts -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Apparel_ShieldBelt"]</xpath>
		<value>
			<costList Operation="SafeAdd">
				<ComponentSpacer>2</ComponentSpacer>
				<Plasteel>25</Plasteel>
			</costList>
			<recipeMaker Operation="Safe">
				<recipeUsers Operation="Safe">
					<li Operation="SafeAdd" Compare="InnerText">FabricationBench</li>
					<li Operation="SafeRemove" Compare="InnerText">TableMachining</li>
				</recipeUsers>
			</recipeMaker>
		</value>
	</Operation>

	<!-- Apparel Utility -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Apparel_PsychicShockLance"]</xpath>
		<value>
			<tradeNeverStack Operation="SafeRemove"/>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Apparel_PsychicInsanityLance"]</xpath>
		<value>
			<tradeNeverStack Operation="SafeRemove"/>
		</value>
	</Operation>

	<!-- Apparel Headgear -->
	<Operation Class="XmlExtensions.PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Apparel_PowerArmorHelmet"]</xpath>
		<attribute>Name</attribute>
		<value>Apparel_PowerArmorHelmet</value>
	</Operation>

	<Operation Class="XmlExtensions.PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetRecon"]</xpath>
		<attribute>Name</attribute>
		<value>Apparel_ArmorHelmetRecon</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Apparel_PsychicFoilHelmet"]</xpath>
		<value>
			<equippedStatOffsets Operation="Safe">
				<PsychicSensitivity Operation="SafeRemove">0</PsychicSensitivity>
				<PsychicSensitivityOffset Operation="SafeAdd">-1</PsychicSensitivityOffset>
			</equippedStatOffsets>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Apparel_ClothMask"]</xpath>
		<attribute>Name</attribute>
		<value>Apparel_ClothMask</value>
	</Operation>

	<!-- Apparel Various -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Apparel_FlakVest" 
			or defName="Apparel_FlakPants" 
			or defName="Apparel_FlakJacket"]</xpath>
		<value>
			<equippedStatOffsets Operation="Safe">
				<MoveSpeed Operation="SafeReplace">-0.1</MoveSpeed>
			</equippedStatOffsets>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[@Name="ApparelArmorHelmetReconBase"]</xpath>
		<value>
			<costList Operation="SafeReplace">
				<ComponentSpacer>1</ComponentSpacer>
				<Plasteel>50</Plasteel>
				<RB_BallisticGlass MayRequire="rebuild.cotr.doorsandcorners">5</RB_BallisticGlass>
			</costList>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[@Name="ApparelArmorReconBase"]</xpath>
		<value>
			<costList Operation="SafeReplace">
				<ComponentSpacer>4</ComponentSpacer>
				<Plasteel>100</Plasteel>
				<Uranium>25</Uranium>
			</costList>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[@Name="ApparelArmorHelmetPowerBase"]</xpath>
		<value>
			<costList Operation="SafeReplace">
				<ComponentSpacer>1</ComponentSpacer>
				<Plasteel>50</Plasteel>
				<RB_BallisticGlass MayRequire="rebuild.cotr.doorsandcorners">5</RB_BallisticGlass>
			</costList>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[@Name="ApparelArmorPowerBase"]</xpath>
		<value>
			<costList Operation="SafeReplace">
				<ComponentSpacer>6</ComponentSpacer>
				<Plasteel>125</Plasteel>
				<Uranium>50</Uranium>
			</costList>
			<equippedStatOffsets Operation="Safe">
				<MoveSpeed Operation="SafeReplace">-0.2</MoveSpeed>
			</equippedStatOffsets>
		</value>
	</Operation>

</Patch>
