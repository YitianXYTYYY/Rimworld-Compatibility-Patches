<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="ShardAnimalPulser"]</xpath>
		<value>
			<tradeNeverStack Operation="SafeRemove"/>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="BiomutationPulser"]</xpath>
		<value>
			<tradeNeverStack Operation="SafeRemove"/>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="GoldenCube"]</xpath>
		<value>
			<statBases Operation="Safe">
				<MarketValue Operation="SafeReplace">0</MarketValue>
			</statBases>
		</value>
	</Operation>

	<!-- bioferrite -->
	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/ThingDef[defName="Bioferrite"]</xpath>
		<apply>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>ThingDef/stuffProps/statFactorsQuality/li[stat="PsychicSensitivityFactor"]</xpath>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>ThingDef/stuffProps/statOffsetsQuality/li[stat="PsychicEntropyMaxOffset"]</xpath>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>ThingDef/stuffProps/statOffsetsQuality/li[stat="PsychicEntropyRecoveryRateOffset"]</xpath>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>ThingDef</xpath>
				<value>
					<stuffProps Operation="Safe">
						<statOffsetsQuality Operation="Safe">
							<li MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Biotech" Operation="SafeAdd" XPathLocal="stat">
								<stat>PsychicSensitivityOffset</stat>
								<awful>0.1</awful>
								<poor>0.1</poor>
								<normal>0.1</normal>
								<good>0.1</good>
								<excellent>0.1</excellent>
								<masterwork>0.1</masterwork>
								<legendary>0.1</legendary>
							</li>
						</statOffsetsQuality>
					</stuffProps>
				</value>
			</Operation>
		</apply>
	</Operation>

</Patch>
