<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- juggernaut serum -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/HediffDef[defName="JuggernautSerum"]/stages/li</xpath>
		<value>
			<capMods Operation="Safe">
				<li Operation="SafeAdd" Compare="InnerText" XPathLocal="capacity">
					<capacity>Moving</capacity>
					<offset>0.1</offset>
				</li>
			</capMods>
			<statFactors Operation="Safe">
				<MeleeDamageFactor Operation="SafeRemove">0</MeleeDamageFactor>
				<InjuryHealingFactor Operation="SafeRemove">0</InjuryHealingFactor>
			</statFactors>
			<statOffsets Operation="Safe">
				<InjuryHealingFactor Operation="SafeAdd">1</InjuryHealingFactor>
				<MeleeDamageFactor Operation="SafeAdd">0.5</MeleeDamageFactor>
				<MoveSpeed Operation="SafeRemove">0</MoveSpeed>
			</statOffsets>
		</value>
	</Operation>

	<!-- metalblood serum -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/HediffDef[defName="Metalblood"]/stages/li</xpath>
		<value>
			<statFactors Operation="Safe">
				<IncomingDamageFactor Operation="SafeReplace">0.5</IncomingDamageFactor>
			</statFactors>
		</value>
	</Operation>

	<!-- voidsight serum -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/HediffDef[defName="Voidsight"]/stages/li</xpath>
		<value>
			<statFactors Operation="Safe">
				<StudyEfficiency Operation="SafeRemove">0</StudyEfficiency>
				<PsychicSensitivity Operation="SafeRemove">0</PsychicSensitivity>
			</statFactors>
			<statOffsets Operation="Safe">
				<StudyEfficiency Operation="SafeAdd">0.2</StudyEfficiency>
				<PsychicSensitivity Operation="SafeAdd">0.4</PsychicSensitivity>
			</statOffsets>
		</value>
	</Operation>

	<!-- mind-numb serum -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/HediffDef[defName="MindNumbSerum"]/stages/li</xpath>
		<value>
			<capMods Operation="Safe">
				<li Operation="Safe" Compare="InnerText" XPathLocal="capacity">
					<capacity Operation="Safe">Consciousness</capacity>
					<offset Operation="SafeRemove">0</offset>
					<setMax Operation="SafeAdd">0.9</setMax>
				</li>
			</capMods>
		</value>
	</Operation>

</Patch>
