<?xml version="1.0" encoding="utf-8"?>
<Patch>
	
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="NerveSpiker"]</xpath>
		<value>
			<weaponTags Operation="Safe">
				<li Operation="Add">ammoDef_AmmoPrimitive/10/1</li>
			</weaponTags>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/ThingDef[defName="Gun_HellcatRifle"]</xpath>
		<apply>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>ThingDef/comps/li[@Class="CompProperties_Art"]</xpath>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>ThingDef</xpath>
				<value>
					<weaponTags Operation="Safe">
						<li Operation="Add">ammoDef_AmmoIndustrial/30/1</li>
					</weaponTags>
				</value>
			</Operation>
		</apply>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Gun_Incinerator"]</xpath>
		<value>
			<weaponTags Operation="Safe">
				<li Operation="Add">ammoDef_Chemfuel/100/1</li>
			</weaponTags>
		</value>
	</Operation>

</Patch>
