<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- casts -->
	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/HediffDef[defName="CombatCommand"]</xpath>
		<apply>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>redmattis.betterprerequisites</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>HediffDef</xpath>
						<value>
							<modExtensions Operation="Safe">
								<li Class="BigAndSmall.PawnExtension" Operation="Safe" CheckAttributes="True">
									<hediffFilters Operation="Safe">
										<banlist Operation="Safe">
											<li Operation="SafeAdd" Compare="InnerText">CombatCommandBuff</li>
										</banlist>
									</hediffFilters>
								</li>
							</modExtensions>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</apply>
	</Operation>
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/HediffDef[defName="CombatCommandBuff"]/stages/li</xpath>
		<value>
			<statOffsets Operation="Safe">
				<ShootingAccuracyPawn Operation="SafeReplace">4</ShootingAccuracyPawn>
				<MeleeHitChance Operation="SafeReplace">4</MeleeHitChance>
			</statOffsets>
		</value>
	</Operation>

