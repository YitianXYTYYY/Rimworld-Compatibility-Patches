<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Flamebow"]</xpath>
		<value>
			<weaponTags Operation="Safe">
				<li Operation="Add">ammoDef_AmmoPrimitive/10/1</li>
			</weaponTags>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/ThingDef[defName="Weapon_GrenadeTox"]</xpath>
		<apply>
			<Operation Class="XmlExtensions.PatchOperationAttributeSet">
				<xpath>ThingDef</xpath>
				<attribute>Name</attribute>
				<value>Weapon_GrenadeTox</value>
			</Operation>
		</apply>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Gun_ToxbombLauncher"]</xpath>
		<value>
			<statBases Operation="Safe">
				<RangedWeapon_Cooldown Operation="SafeReplace">2.5</RangedWeapon_Cooldown>
			</statBases>
			<verbs Operation="Safe">
				<li Operation="Safe" Compare="InnerText" XPathLocal="verbClass">
					<verbClass Operation="Safe">Verb_Shoot</verbClass>
					<warmupTime Operation="SafeReplace">2</warmupTime>
				</li>
			</verbs>
			<weaponTags Operation="Safe">
				<li Operation="Add">ammoDef_WeaponGrenadeTox/5/1</li>
			</weaponTags>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Gun_Slugthrower" or 
			defName="Gun_Spiner"]</xpath>
		<value>
			<weaponTags Operation="Safe">
				<li Operation="Add">ammoDef_AmmoIndustrial/25/1</li>
			</weaponTags>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Gun_MiniShotgun"]</xpath>
		<value>
			<weaponTags Operation="Safe">
				<li Operation="Add">ammoDef_AmmoIndustrial/25/2</li>
			</weaponTags>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Gun_MiniFlameblaster"]</xpath>
		<value>
			<weaponTags Operation="Safe">
				<li Operation="Add">ammoDef_Chemfuel/50/1</li>
			</weaponTags>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Gun_ToxicNeedle" or 
			defName="Gun_NeedleLauncher"]</xpath>
		<value>
			<weaponTags Operation="Safe">
				<li Operation="Add">ammoDef_Uranium/25/1</li>
			</weaponTags>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Gun_BeamGraser"]</xpath>
		<value>
			<weaponTags Operation="Safe">
				<li Operation="Add">ammoDef_AmmoSpacerEMP/75/1</li>
			</weaponTags>
		</value>
	</Operation>
	
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Gun_HellsphereCannon"]</xpath>
		<value>
			<weaponTags Operation="Safe">
				<li Operation="Add">ammoDef_AmmoSpacerEMP/10/5</li>
			</weaponTags>
		</value>
	</Operation>

</Patch>
