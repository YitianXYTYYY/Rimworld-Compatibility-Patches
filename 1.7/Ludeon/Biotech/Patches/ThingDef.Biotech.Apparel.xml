<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- headsets -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Apparel_AirwireHeadset" 
			or defName="Apparel_ArrayHeadset"]</xpath>
		<value>
			<apparel Operation="Safe">
				<bodyPartGroups Operation="Safe">
					<li Operation="SafeRemove" Compare="InnerText">UpperHead</li>
					<li Operation="SafeAdd" Compare="InnerText">Eyes</li>
				</bodyPartGroups>
			</apparel>
		</value>
	</Operation>
	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/ThingDef[defName="Apparel_IntegratorHeadset"]</xpath>
		<apply>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>ThingDef</xpath>
				<value>
					<apparel Operation="Safe">
						<bodyPartGroups Operation="Safe">
							<li Operation="SafeRemove" Compare="InnerText">UpperHead</li>
							<li Operation="SafeAdd" Compare="InnerText">Eyes</li>
						</bodyPartGroups>
					</apparel>
					<costList Operation="SafeReplace">
						<ComponentSpacer>5</ComponentSpacer>
						<Plasteel>50</Plasteel>
						<PowerfocusChip>1</PowerfocusChip>
					</costList>
					<equippedStatOffsets Operation="Safe">
						<VacuumResistance Operation="SafeRemove">0</VacuumResistance>
					</equippedStatOffsets>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.PatchOperationAttributeAdd">
				<xpath>ThingDef/equippedStatOffsets</xpath>
				<attribute>Inherit</attribute>
				<value>False</value>
			</Operation>
		</apply>
	</Operation>

	<!-- mechlord -->
	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetMechlordHelmet"]</xpath>
		<apply>
			<Operation Class="XmlExtensions.PatchOperationAttributeSet">
				<xpath>ThingDef</xpath>
				<attribute>Name</attribute>
				<value>Apparel_ArmorHelmetMechlordHelmet</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>ThingDef</xpath>
				<value>
					<costList Operation="Safe">
						<Plasteel Operation="SafeReplace">100</Plasteel>
					</costList>
					<equippedStatOffsets Operation="Safe">
						<ShootingAccuracyPawn Operation="SafeReplace">-4</ShootingAccuracyPawn>
						<MeleeHitChance Operation="SafeReplace">-1</MeleeHitChance>
					</equippedStatOffsets>
				</value>
			</Operation>
		</apply>
	</Operation>
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Apparel_MechlordSuit"]</xpath>
		<value>
			<costList Operation="SafeReplace">
				<ComponentSpacer>8</ComponentSpacer>
				<Plasteel>150</Plasteel>
				<Uranium>50</Uranium>
				<NanostructuringChip>2</NanostructuringChip>
				<PowerfocusChip>1</PowerfocusChip>
			</costList>
			<equippedStatOffsets Operation="Safe">
				<ShootingAccuracyPawn Operation="SafeReplace">-4</ShootingAccuracyPawn>
				<MeleeHitChance Operation="SafeReplace">-1</MeleeHitChance>
			</equippedStatOffsets>
		</value>
	</Operation>

	<!-- bandolier -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ThingDef[defName="Apparel_Bandolier"]</xpath>
		<value>
			<equippedStatOffsets Operation="Safe">
				<RangedCooldownFactor Operation="SafeRemove">0</RangedCooldownFactor>
			</equippedStatOffsets>
			<modExtensions Operation="Safe">
				<li Class="VEF.Apparels.ApparelExtension" Operation="Safe" CheckAttributes="True">
					<equippedStatFactors Operation="Safe">
						<RangedCooldownFactor Operation="SafeAdd">0.8</RangedCooldownFactor>
					</equippedStatFactors>
				</li>
			</modExtensions>
		</value>
	</Operation>

</Patch>
