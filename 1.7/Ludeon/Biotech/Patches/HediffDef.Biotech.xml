<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- global misc -->
	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/HediffDef[defName="PregnantHuman"]</xpath>
		<apply>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>HediffDef/stages/li/hungerRateFactorOffset</xpath>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>HediffDef/stages/li[label="first trimester"]</xpath>
				<value>
					<hungerRateFactor Operation="SafeAdd">1.2</hungerRateFactor>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>HediffDef/stages/li[label="second trimester"]</xpath>
				<value>
					<hungerRateFactor Operation="SafeAdd">1.2</hungerRateFactor>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>HediffDef/stages/li[label="third trimester"]</xpath>
				<value>
					<hungerRateFactor Operation="SafeAdd">1.5</hungerRateFactor>
				</value>
			</Operation>
		</apply>
	</Operation>

	<!-- various -->
	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/HediffDef[defName="BioStarvation"]/stages/li</xpath>
		<value>
			<hungerRateFactor Operation="SafeAdd">1.5</hungerRateFactor>
			<hungerRateFactorOffset Operation="SafeRemove"/>
		</value>
	</Operation>

	<!-- deathrest -->
	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/HediffDef[defName="GlucosoidRush"]</xpath>
		<apply>
			<Operation Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>HediffDef/stages/li</xpath>
			</Operation>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>HediffDef/stages</xpath>
				<value>
					<li Operation="SafeAdd" Compare="InnerText" XPathLocal="minSeverity">
						<minSeverity>1</minSeverity>
						<capMods>
							<li>
								<capacity>Moving</capacity>
								<offset>0.1</offset>
							</li>
						</capMods>
					</li>
					<li Operation="SafeAdd" Compare="InnerText" XPathLocal="minSeverity">
						<minSeverity>2</minSeverity>
						<capMods>
							<li>
								<capacity>Moving</capacity>
								<offset>0.2</offset>
							</li>
						</capMods>
					</li>
					<li Operation="SafeAdd" Compare="InnerText" XPathLocal="minSeverity">
						<minSeverity>3</minSeverity>
						<capMods>
							<li>
								<capacity>Moving</capacity>
								<offset>0.3</offset>
							</li>
						</capMods>
					</li>
					<li Operation="SafeAdd" Compare="InnerText" XPathLocal="minSeverity">
						<minSeverity>4</minSeverity>
						<capMods>
							<li>
								<capacity>Moving</capacity>
								<offset>0.4</offset>
							</li>
						</capMods>
					</li>
				</value>
			</Operation>
		</apply>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/HediffDef[defName="PsychofluidRush"]/stages/li</xpath>
		<value>
			<statOffsets Operation="Safe">
				<PsychicSensitivity Operation="SafeReplace">0.2</PsychicSensitivity>
			</statOffsets>
		</value>
	</Operation>

</Patch>
