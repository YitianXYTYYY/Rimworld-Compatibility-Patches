<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ResearchProjectDef[defName="ToxifierGenerator"]</xpath>
		<value>
			<prerequisites Operation="Safe">
				<li Operation="SafeRemove" Compare="InnerText">Electricity</li>
				<li Operation="SafeAdd" Compare="InnerText">MicroelectronicsBasics</li>
			</prerequisites>
			<requiredResearchBuilding Operation="SafeAdd">HiTechResearchBench</requiredResearchBuilding>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ResearchProjectDef[defName="WastepackAtomizer"]</xpath>
		<value>
			<techLevel Operation="SafeReplace">Spacer</techLevel>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ResearchProjectDef[defName="Archogenetics"]</xpath>
		<value>
			<prerequisites Operation="Safe">
				<li Operation="SafeRemove" Compare="InnerText">Fabrication</li>
			</prerequisites>
			<hiddenPrerequisites Operation="Safe">
				<li Operation="SafeAdd" Compare="InnerText">Fabrication</li>
			</hiddenPrerequisites>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ResearchProjectDef[defName="Deathrest"]</xpath>
		<value>
			<prerequisites Operation="Safe">
				<li Operation="SafeRemove" Compare="InnerText">Electricity</li>
			</prerequisites>
			<hiddenPrerequisites Operation="Safe">
				<li Operation="SafeAdd" Compare="InnerText">Electricity</li>
			</hiddenPrerequisites>
			<requiredResearchBuilding Operation="SafeAdd">HiTechResearchBench</requiredResearchBuilding>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ResearchProjectDef[defName="FertilityProcedures"]</xpath>
		<value>
			<prerequisites Operation="Safe">
				<li Operation="SafeRemove" Compare="InnerText">Electricity</li>
				<li Operation="SafeAdd" Compare="InnerText">SterileMaterials</li>
			</prerequisites>
		</value>
	</Operation>

	<Operation Class="XmlExtensions.HybridPatch">
		<xpath>Defs/ResearchProjectDef[defName="ToxFiltration"]</xpath>
		<value>
			<prerequisites Operation="Safe">
				<li Operation="SafeAdd" Compare="InnerText">Bionics</li>
				<li Operation="SafeRemove" Compare="InnerText">Fabrication</li>
			</prerequisites>
			<hiddenPrerequisites Operation="Safe">
				<li Operation="SafeRemove" Compare="InnerText">Prosthetics</li>
			</hiddenPrerequisites>
			<!--tab Operation="AddOrReplace">TechProsthetics</tab-->
		</value>
	</Operation>

	<Operation Class="XmlExtensions.SetScope">
		<xpath>Defs/ResearchProjectDef[defName="GrowthVats"]</xpath>
		<apply>
			<Operation Class="XmlExtensions.HybridPatch">
				<xpath>ResearchProjectDef</xpath>
				<value>
					<prerequisites Operation="Safe">
						<li Operation="SafeRemove" Compare="InnerText">MicroelectronicsBasics</li>
					</prerequisites>
					<hiddenPrerequisites Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">VitalsMonitor</li>
					</hiddenPrerequisites>
					<requiredResearchFacilities Operation="Safe">
						<li Operation="SafeAdd" Compare="InnerText">MultiAnalyzer</li>
					</requiredResearchFacilities>
				</value>
			</Operation>
			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>vanillaexpanded.vgeneticse</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>ResearchProjectDef</xpath>
						<value>
							<tab Operation="AddOrReplace">GR_GeneticReseach</tab>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</apply>
	</Operation>

</Patch>
